diff --git a/src/test/java/dal/PersistenceDalpuTest.java b/src/test/java/dal/PersistenceDalpuTest.java
new file mode 100644
index 0000000..6d19bfa
--- /dev/null
+++ b/src/test/java/dal/PersistenceDalpuTest.java
@@ -0,0 +1,54 @@
+package dal;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.TreeSet;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * L'unite DALPU (EclipseLink) liste ses entites explicitement : une entite ajoutee au code doit l'etre aussi dans
+ * persistence.xml, sinon les ecrans JSP ne la connaissent pas. Ce test echoue tant que les deux listes different.
+ */
+public class PersistenceDalpuTest {
+
+    private static final Pattern ANNOTATION = Pattern.compile(
+            "^\\s*@(jakarta\\.persistence\\.)?(Entity|Embeddable|MappedSuperclass)\\b|^\\s*@(jakarta\\.persistence\\.)?Converter\\s*\\(\\s*autoApply\\s*=\\s*true",
+            Pattern.MULTILINE);
+
+    @Test
+    public void lesEntitesDeDalpuSontCellesDuCode() throws IOException {
+        TreeSet<String> code = new TreeSet<>();
+        Path racine = Paths.get("src/main/java");
+        try (Stream<Path> fichiers = Files.walk(racine)) {
+            for (Path f : (Iterable<Path>) fichiers.filter(p -> p.toString().endsWith(".java"))::iterator) {
+                String t = new String(Files.readAllBytes(f), StandardCharsets.UTF_8);
+                if (ANNOTATION.matcher(t).find()) {
+                    String nom = racine.relativize(f).toString().replace('\\', '/').replace('/', '.');
+                    code.add(nom.substring(0, nom.length() - ".java".length()));
+                }
+            }
+        }
+        String xml;
+        try (InputStream in = getClass().getResourceAsStream("/META-INF/persistence.xml")) {
+            xml = new String(in.readAllBytes(), StandardCharsets.UTF_8);
+        }
+        String dalpu = xml.substring(xml.indexOf("<persistence-unit name=\"DALPU\""),
+                xml.indexOf("</persistence-unit>", xml.indexOf("<persistence-unit name=\"DALPU\"")));
+        TreeSet<String> listees = new TreeSet<>();
+        Matcher m = Pattern.compile("<class>([^<]+)</class>").matcher(dalpu);
+        while (m.find()) {
+            listees.add(m.group(1).trim());
+        }
+        assertEquals(code, listees);
+    }
+}
