diff --git a/src/main/resources/META-INF/persistence.xml b/src/main/resources/META-INF/persistence.xml
index b884fc2..69fead2 100644
--- a/src/main/resources/META-INF/persistence.xml
+++ b/src/main/resources/META-INF/persistence.xml
@@ -4,6 +4,13 @@
   <non-jta-data-source>jdbc/__laborex_pool</non-jta-data-source>
   <exclude-unlisted-classes>false</exclude-unlisted-classes>
   <shared-cache-mode>NONE</shared-cache-mode>
+  <properties>
+   <!-- Les classes de metamodele (TFamille_...) sont partagees par les deux unites. Sous Payara 7, EclipseLink les
+        remplissait apres Hibernate avec ses propres objets, qu'Hibernate 7 refuse (ClassCastException). EclipseLink
+        les cherche donc dans un sous-paquetage qui n'existe pas et n'y touche plus ; il lit sans difficulte ceux
+        d'Hibernate (nom, type, nature de l'attribut, par les interfaces standard). -->
+   <property name="eclipselink.canonicalmodel.subpackage" value="aucun_metamodele_eclipselink"/>
+  </properties>
  </persistence-unit>
  <persistence-unit name="JTA_UNIT" transaction-type="JTA">
   <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
@@ -11,10 +18,18 @@
   <exclude-unlisted-classes>false</exclude-unlisted-classes>
   <shared-cache-mode>NONE</shared-cache-mode>
   <properties>
-   <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL5InnoDBDialect"/>
+   <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
+   <!-- Pas d'amelioration du bytecode par le serveur, comme sous Hibernate 5 : sous Payara 7, le
+        transformateur qu'Hibernate 7 inscrit par defaut provoque une ClassCircularityError au deploiement. -->
+   <!-- Requetes SQL natives : dates et heures en java.sql.Date / Timestamp / Time, comme sous Hibernate 5
+        (Hibernate 7 rend sinon des LocalDate / LocalDateTime, que le code convertit en java.sql). -->
+   <property name="hibernate.query.native.prefer_jdbc_datetime_types" value="true"/>
+   <property name="hibernate.enhancer.enableDirtyTracking" value="false"/>
+   <property name="hibernate.enhancer.enableLazyInitialization" value="false"/>
+   <property name="hibernate.enhancer.enableAssociationManagement" value="false"/>
    <!--   <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>-->
-   <property name="hibernate.transaction.jta.platform" value="org.hibernate.service.jta.platform.internal.SunOneJtaPlatform"/>
+   <property name="hibernate.transaction.jta.platform" value="org.hibernate.engine.transaction.jta.platform.internal.GlassFishJtaPlatform"/>
   </properties>
  </persistence-unit>
 </persistence>
