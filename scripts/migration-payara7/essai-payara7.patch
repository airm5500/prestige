diff --git a/src/test/java/dal/CompteurCommunTest.java b/src/test/java/dal/CompteurCommunTest.java
new file mode 100644
index 0000000..df7345d
--- /dev/null
+++ b/src/test/java/dal/CompteurCommunTest.java
@@ -0,0 +1,55 @@
+package dal;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.Properties;
+import java.util.TreeSet;
+import java.util.stream.Stream;
+
+import org.hibernate.id.OptimizableGenerator;
+import org.hibernate.id.enhanced.SequenceStyleGenerator;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Sous Hibernate 7, une entite en GenerationType.AUTO chercherait une sequence propre qui n'existe pas en base : les
+ * identifiants generes doivent passer par le compteur commun d'Hibernate 5 (ou etre en IDENTITY).
+ */
+public class CompteurCommunTest {
+
+    @Test
+    public void aucuneEntiteEnAuto() throws IOException {
+        TreeSet<String> enAuto = new TreeSet<>();
+        TreeSet<String> compteur = new TreeSet<>();
+        try (Stream<Path> fichiers = Files.walk(Paths.get("src/main/java"))) {
+            for (Path f : (Iterable<Path>) fichiers.filter(p -> p.toString().endsWith(".java")
+                    && !p.getFileName().toString().startsWith("CompteurCommun"))::iterator) {
+                String t = new String(Files.readAllBytes(f), StandardCharsets.UTF_8);
+                if (t.contains("GenerationType.AUTO") || t.contains("GenerationType.SEQUENCE")
+                        || t.matches("(?s).*@GeneratedValue\\s*(\\(\\s*\\))?\\s*\\n.*")) {
+                    enAuto.add(f.getFileName().toString());
+                }
+                if (t.contains("@CompteurCommun\n") || t.contains("@CompteurCommun\r\n")) {
+                    compteur.add(f.getFileName().toString());
+                }
+            }
+        }
+        assertTrue(enAuto.isEmpty(), "identifiants AUTO : " + enAuto);
+        assertEquals(7, compteur.size(), compteur.toString());
+    }
+
+    @Test
+    public void memeReglageQuHibernate5() {
+        Properties p = CompteurCommunGenerateur.reglage(new Properties());
+        assertEquals("hibernate_sequence", p.getProperty(SequenceStyleGenerator.SEQUENCE_PARAM));
+        assertEquals("true", p.getProperty(SequenceStyleGenerator.FORCE_TBL_PARAM));
+        assertEquals("next_val", p.getProperty(SequenceStyleGenerator.VALUE_COLUMN_PARAM));
+        assertEquals("1", p.getProperty(OptimizableGenerator.INCREMENT_PARAM));
+        assertEquals("none", p.getProperty(OptimizableGenerator.OPT_PARAM));
+    }
+}
