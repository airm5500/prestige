+/**
+ * Identifiant tire du compteur commun {@code hibernate_sequence}, comme sous Hibernate 5.
+ *
+ * Sous Hibernate 5, les entites en {@code GenerationType.AUTO} partageaient la table {@code hibernate_sequence}.
+ * Hibernate 7 attend a la place une sequence par entite ({@code ligne_resume_caisse_SEQ}...) qui n'existe pas en base :
+ * constate au banc, la cloture de caisse tombait en erreur. Ce generateur relit la meme table, de la meme facon
+ * (incrément 1), sans rien changer a la base : un retour a Payara 5 reste possible.
+ */
+@IdGeneratorType(CompteurCommunGenerateur.class)
+@Retention(RUNTIME)
+@Target({ FIELD, METHOD })
+public @interface CompteurCommun {
+}
diff --git a/src/main/java/dal/CompteurCommunGenerateur.java b/src/main/java/dal/CompteurCommunGenerateur.java
new file mode 100644
index 0000000..5ab2276
--- /dev/null
+++ b/src/main/java/dal/CompteurCommunGenerateur.java
@@ -0,0 +1,29 @@
+package dal;
+
+import java.util.Properties;
+import org.hibernate.MappingException;
+import org.hibernate.generator.GeneratorCreationContext;
+import org.hibernate.id.enhanced.SequenceStyleGenerator;
+
+/**
+ * Generateur de {@link CompteurCommun} : la table {@code hibernate_sequence} (colonne {@code next_val}), lue et avancee
+ * de 1 dans sa propre transaction, exactement comme le faisait Hibernate 5.
+ */
+public class CompteurCommunGenerateur extends SequenceStyleGenerator {
+
+    public static final String TABLE = "hibernate_sequence";
+
+    @Override
+    public void configure(GeneratorCreationContext contexte, Properties parametres) throws MappingException {
+        super.configure(contexte, reglage(parametres));
+    }
+
+    static Properties reglage(Properties parametres) {
+        parametres.setProperty(SEQUENCE_PARAM, TABLE);
+        parametres.setProperty(FORCE_TBL_PARAM, "true");
+        parametres.setProperty(VALUE_COLUMN_PARAM, DEF_VALUE_COLUMN);
+        parametres.setProperty(INCREMENT_PARAM, "1");
+        parametres.setProperty(OPT_PARAM, "none");
+        return parametres;
+    }
+}
