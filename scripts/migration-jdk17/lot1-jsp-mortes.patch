+    /**
+     * Trace du changement de prix de vente dans le mouchard des prix, dans la transaction de la modification : un prix
+     * change depuis le bon de livraison apparait au mouchard comme un prix change a la commande
+     * (OrderServiceImpl.saveMouvementPrice).
+     */
+    private void tracerPrixVente(TFamille famille, Integer ancienPrix, int nouveauPrix, String reference,
+            EntityManager em) {
+        if (famille == null || ancienPrix == null || ancienPrix == nouveauPrix) {
+            return;
+        }
+        Date maintenant = new Date();
+        TMouvementprice mouvement = new TMouvementprice(UUID.randomUUID().toString());
+        mouvement.setLgUSERID(this.getOTUser());
+        mouvement.setStrACTION(Constant.ACTION_COMMANDE);
+        mouvement.setDtCREATED(maintenant);
+        mouvement.setDtUPDATED(maintenant);
+        mouvement.setDtDAY(maintenant);
+        mouvement.setIntPRICENEW(nouveauPrix);
+        mouvement.setIntPRICEOLD(ancienPrix);
+        mouvement.setStrREF(reference);
+        mouvement.setStrSTATUT(Constant.STATUT_ENABLE);
+        mouvement.setLgFAMILLEID(famille);
+        em.persist(mouvement);
+    }
