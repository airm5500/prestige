diff --git a/src/main/java/util/SeparateurMilliers.java b/src/main/java/util/SeparateurMilliers.java
new file mode 100644
index 0000000..495fc25
--- /dev/null
+++ b/src/main/java/util/SeparateurMilliers.java
@@ -0,0 +1,100 @@
+package util;
+
+import java.lang.reflect.Method;
+import java.text.DecimalFormat;
+import java.text.DecimalFormatSymbols;
+import java.text.NumberFormat;
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+import net.sf.jasperreports.engine.JRParameter;
+import net.sf.jasperreports.engine.util.DefaultFormatFactory;
+
+/**
+ * Separateur de milliers identique quel que soit le JDK.
+ *
+ * Jusqu'au JDK 12, la locale francaise separe les milliers par une espace insecable (U+00A0). A partir du JDK 13, elle
+ * utilise une espace fine insecable (U+202F), que la police des etats (Helvetica, encodage Cp1252) ne connait pas : le
+ * caractere est supprime sans erreur et 1 234 567 devient 1234567.
+ *
+ * Cette classe remet l'espace insecable partout ou le JDK produirait l'espace fine. Sur JDK 11 elle ne change rien,
+ * puisque le JDK y produit deja l'espace insecable.
+ */
+public final class SeparateurMilliers {
+
+    public static final char ESPACE_INSECABLE = ' ';
+    public static final char ESPACE_FINE = ' ';
+
+    /** Fabrique de formats a passer aux etats ; sans etat interne, une seule instance suffit. */
+    public static final FabriqueFormats FABRIQUE = new FabriqueFormats();
+
+    /* Separateur de milliers monetaire, distinct depuis le JDK 15 : ces methodes n'existent pas sur JDK 11. */
+    private static final Method LIRE_MONETAIRE = methode("getMonetaryGroupingSeparator");
+    private static final Method ECRIRE_MONETAIRE = methode("setMonetaryGroupingSeparator", char.class);
+
+    private SeparateurMilliers() {
+    }
+
+    /** Remplace l'espace fine par l'espace insecable dans un texte deja formate. */
+    public static String corriger(String texte) {
+        return texte == null ? null : texte.replace(ESPACE_FINE, ESPACE_INSECABLE);
+    }
+
+    /** Corrige les symboles d'un format de nombre ; le meme objet est rendu, pour s'utiliser en ligne. */
+    public static <T extends NumberFormat> T corriger(T format) {
+        if (format instanceof DecimalFormat) {
+            DecimalFormat df = (DecimalFormat) format;
+            DecimalFormatSymbols symboles = df.getDecimalFormatSymbols();
+            boolean modifie = false;
+            if (symboles.getGroupingSeparator() == ESPACE_FINE) {
+                symboles.setGroupingSeparator(ESPACE_INSECABLE);
+                modifie = true;
+            }
+            if (LIRE_MONETAIRE != null && ECRIRE_MONETAIRE != null) {
+                try {
+                    if (Character.valueOf(ESPACE_FINE).equals(LIRE_MONETAIRE.invoke(symboles))) {
+                        ECRIRE_MONETAIRE.invoke(symboles, ESPACE_INSECABLE);
+                        modifie = true;
+                    }
+                } catch (ReflectiveOperationException e) {
+                    throw new IllegalStateException(e);
+                }
+            }
+            if (modifie) {
+                df.setDecimalFormatSymbols(symboles);
+            }
+        }
+        return format;
+    }
+
+    /**
+     * Parametres d'un etat avec la fabrique de formats. Copie la table recue sans la modifier ; une fabrique deja
+     * fournie par l'appelant est conservee.
+     */
+    public static Map<String, Object> parametres(Map<String, ?> parametres) {
+        Map<String, Object> copie = parametres == null ? new HashMap<>() : new HashMap<>(parametres);
+        copie.putIfAbsent(JRParameter.REPORT_FORMAT_FACTORY, FABRIQUE);
+        return copie;
+    }
+
+    private static Method methode(String nom, Class<?>... types) {
+        try {
+            return DecimalFormatSymbols.class.getMethod(nom, types);
+        } catch (NoSuchMethodException e) {
+            return null;
+        }
+    }
+
+    /**
+     * Formats des etats JasperReports : ceux de JasperReports, separateur de milliers corrige. Les sous-rapports en
+     * heritent, sauf s'ils declarent leur propre formatFactoryClass.
+     */
+    public static final class FabriqueFormats extends DefaultFormatFactory {
+
+        @Override
+        public NumberFormat createNumberFormat(String pattern, Locale locale) {
+            return corriger(super.createNumberFormat(pattern, locale));
+        }
+    }
+}
