diff --git a/src/test/java/util/SeparateurMilliersTest.java b/src/test/java/util/SeparateurMilliersTest.java
new file mode 100644
index 0000000..dabbf8b
--- /dev/null
+++ b/src/test/java/util/SeparateurMilliersTest.java
@@ -0,0 +1,120 @@
+package util;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.text.DecimalFormat;
+import java.text.NumberFormat;
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+import org.junit.jupiter.api.Test;
+
+import net.sf.jasperreports.engine.JREmptyDataSource;
+import net.sf.jasperreports.engine.JRParameter;
+import net.sf.jasperreports.engine.JRPrintText;
+import net.sf.jasperreports.engine.JasperCompileManager;
+import net.sf.jasperreports.engine.JasperFillManager;
+import net.sf.jasperreports.engine.JasperPrint;
+import net.sf.jasperreports.engine.JasperReport;
+import net.sf.jasperreports.engine.util.DefaultFormatFactory;
+
+/**
+ * Les attendus sont ceux que produit le JDK 11 en francais : ces tests passent a l'identique sur JDK 11 et sur JDK 17,
+ * ce qui est precisement la garantie recherchee.
+ */
+public class SeparateurMilliersTest {
+
+    private static final String UN_MILLION = "1 234 567";
+
+    @Test
+    public void fabriqueDesEtatsMetLEspaceInsecable() {
+        SeparateurMilliers.FabriqueFormats f = SeparateurMilliers.FABRIQUE;
+        assertEquals(UN_MILLION, f.createNumberFormat("#,##0", Locale.FRANCE).format(1234567));
+        assertEquals("-" + UN_MILLION, f.createNumberFormat("#,##0", Locale.FRANCE).format(-1234567));
+        assertEquals(UN_MILLION + ",50", f.createNumberFormat("#,##0.00", Locale.FRANCE).format(1234567.5));
+        // sans motif, JasperReports ne fournit pas de format : la fabrique n'en invente pas
+        assertNull(f.createNumberFormat(null, Locale.FRANCE));
+        assertEquals("999", f.createNumberFormat("#,##0", Locale.FRANCE).format(999));
+    }
+
+    @Test
+    public void fabriqueNeTouchePasLesAutresLocales() {
+        SeparateurMilliers.FabriqueFormats f = SeparateurMilliers.FABRIQUE;
+        DefaultFormatFactory jasper = new DefaultFormatFactory();
+        for (Locale l : new Locale[] { Locale.GERMANY, Locale.US, Locale.UK, Locale.ITALY }) {
+            assertEquals(jasper.createNumberFormat("#,##0.00", l).format(1234567.5),
+                    f.createNumberFormat("#,##0.00", l).format(1234567.5), l.toString());
+        }
+        assertEquals("1.234.567", f.createNumberFormat("#,##0", Locale.GERMANY).format(1234567));
+    }
+
+    @Test
+    public void motifMonetaire() {
+        String texte = SeparateurMilliers.FABRIQUE.createNumberFormat("#,##0 ¤", Locale.FRANCE).format(1234567);
+        assertFalse(texte.indexOf(SeparateurMilliers.ESPACE_FINE) >= 0, texte);
+        assertEquals(UN_MILLION, texte.substring(0, UN_MILLION.length()));
+    }
+
+    @Test
+    public void corrigerUnTexte() {
+        assertEquals(UN_MILLION, SeparateurMilliers.corriger(String.format(Locale.FRANCE, "%,d", 1234567)));
+        assertEquals(UN_MILLION, SeparateurMilliers.corriger("1 234 567"));
+        assertEquals("1 234", SeparateurMilliers.corriger("1 234"));
+        assertNull(SeparateurMilliers.corriger((String) null));
+    }
+
+    @Test
+    public void corrigerUnFormatRendLeMemeObjet() {
+        NumberFormat nf = NumberFormat.getIntegerInstance(Locale.FRANCE);
+        assertSame(nf, SeparateurMilliers.corriger(nf));
+        assertEquals(UN_MILLION, nf.format(1234567));
+        DecimalFormat fcfa = SeparateurMilliers
+                .corriger(new DecimalFormat("#,##0 'FCFA'", java.text.DecimalFormatSymbols.getInstance(Locale.FRANCE)));
+        assertEquals(UN_MILLION + " FCFA", fcfa.format(1234567));
+        assertNull(SeparateurMilliers.corriger((NumberFormat) null));
+    }
+
+    @Test
+    public void parametresCopieSansModifierLOriginal() {
+        Map<String, Object> origine = new HashMap<>();
+        origine.put("A", 1);
+        Map<String, Object> p = SeparateurMilliers.parametres(origine);
+        assertSame(SeparateurMilliers.FABRIQUE, p.get(JRParameter.REPORT_FORMAT_FACTORY));
+        assertEquals(1, p.get("A"));
+        assertFalse(origine.containsKey(JRParameter.REPORT_FORMAT_FACTORY));
+
+        DefaultFormatFactory fournie = new DefaultFormatFactory();
+        origine.put(JRParameter.REPORT_FORMAT_FACTORY, fournie);
+        assertSame(fournie, SeparateurMilliers.parametres(origine).get(JRParameter.REPORT_FORMAT_FACTORY));
+        assertSame(SeparateurMilliers.FABRIQUE,
+                SeparateurMilliers.parametres(null).get(JRParameter.REPORT_FORMAT_FACTORY));
+    }
+
+    /** Bout en bout : un etat compile et rempli comme en production, motif #,##0, locale France. */
+    @Test
+    public void etatJasperRempli() throws Exception {
+        String jrxml = "<jasperReport xmlns=\"http://jasperreports.sourceforge.net/jasperreports\""
+                + " name=\"t\" pageWidth=\"200\" pageHeight=\"50\" columnWidth=\"200\" leftMargin=\"0\""
+                + " rightMargin=\"0\" topMargin=\"0\" bottomMargin=\"0\">"
+                + "<parameter name=\"MONTANT\" class=\"java.lang.Long\"/>"
+                + "<title><band height=\"20\"><textField pattern=\"#,##0\">"
+                + "<reportElement x=\"0\" y=\"0\" width=\"200\" height=\"20\"/>"
+                + "<textFieldExpression><![CDATA[$P{MONTANT}]]></textFieldExpression></textField></band></title>"
+                + "</jasperReport>";
+        JasperReport etat = JasperCompileManager
+                .compileReport(new ByteArrayInputStream(jrxml.getBytes(StandardCharsets.UTF_8)));
+        Map<String, Object> p = new HashMap<>();
+        p.put("MONTANT", 1234567L);
+        p.put(JRParameter.REPORT_LOCALE, Locale.FRANCE);
+        JasperPrint imprime = JasperFillManager.fillReport(etat, SeparateurMilliers.parametres(p),
+                new JREmptyDataSource());
+        JRPrintText texte = (JRPrintText) imprime.getPages().get(0).getElements().get(0);
+        assertEquals(UN_MILLION, texte.getFullText());
+    }
+}
