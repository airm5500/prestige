	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_H_LOGO" class="java.lang.String"/>
	<parameter name="P_H_INSTITUTION" class="java.lang.String"/>
	<parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
	<parameter name="P_PRINTED_BY" class="java.lang.String"/>
	<parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
	<parameter name="P_AUTRE_DESC" class="java.lang.String"/>
	<parameter name="P_EMPLACEMENT_ID" class="java.lang.String"/>
	<parameter name="P_DATE_DEBUT" class="java.lang.String"/>
	<parameter name="P_DATE_FIN" class="java.lang.String"/>
	<parameter name="P_SEARCH" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DATE_FORMAT(m.dt_CREATED, '%d/%m/%Y %H:%i') AS dt_CREATED,
CAST(f.int_CIP AS CHAR) AS int_CIP, f.str_NAME AS str_NAME,
CASE m.str_TYPE WHEN 'ASSORT' THEN 'REAPPRO RESERVE' WHEN 'REASSORT' THEN 'REAPPRO RAYON' ELSE m.str_TYPE END AS str_MOUVEMENT,
m.int_QTE AS int_QTE,
m.int_STOCK_RAYON_AVANT AS rayon_avant, m.int_STOCK_RAYON_APRES AS rayon_apres,
m.int_STOCK_RESERVE_AVANT AS reserve_avant, m.int_STOCK_RESERVE_APRES AS reserve_apres,
TRIM(CONCAT(COALESCE(u.str_FIRST_NAME,''), ' ', COALESCE(u.str_LAST_NAME,''))) AS utilisateur
FROM t_mouvement_reserve m
JOIN t_famille f ON f.lg_FAMILLE_ID = m.lg_FAMILLE_ID
LEFT JOIN t_user u ON u.lg_USER_ID = m.lg_USER_ID
WHERE m.lg_EMPLACEMENT_ID = $P{P_EMPLACEMENT_ID}
AND DATE(m.dt_CREATED) BETWEEN $P{P_DATE_DEBUT} AND $P{P_DATE_FIN}
AND (f.str_NAME LIKE $P{P_SEARCH} OR CAST(f.int_CIP AS CHAR) LIKE $P{P_SEARCH})
AND m.str_TYPE = 'ASSORT'
ORDER BY m.dt_CREATED DESC]]>
	</queryString>
	<field name="dt_CREATED" class="java.lang.String"/>
	<field name="int_CIP" class="java.lang.String"/>
	<field name="str_NAME" class="java.lang.String"/>
	<field name="str_MOUVEMENT" class="java.lang.String"/>
	<field name="int_QTE" class="java.lang.Integer"/>
	<field name="rayon_avant" class="java.lang.Integer"/>
	<field name="rayon_apres" class="java.lang.Integer"/>
	<field name="reserve_avant" class="java.lang.Integer"/>
	<field name="reserve_apres" class="java.lang.Integer"/>
	<field name="utilisateur" class="java.lang.String"/>
	<variable name="v_total_qte" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{int_QTE}]]></variableExpression>
	</variable>
