	<parameter name="P_USER" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT f.int_CIP AS int_CIP, f.str_DESCRIPTION AS str_DESCRIPTION, f.int_PRICE AS int_PRICE_VENTE,
f.int_PRICE AS int_PRICE_REF, f.int_PAF AS int_PAF, f.int_PAT AS int_PAT,
t.int_NUMBER_INIT AS int_NUMBER_INIT, t.int_NUMBER AS int_NUMBER, (t.int_NUMBER - t.int_NUMBER_INIT) AS int_ECART,
fa.str_LIBELLE AS str_LIBELLE_FAMILLEARTICLE, z.str_LIBELLEE AS str_LIBELLEE_ZONE, z.str_CODE AS str_CODE_EMPLACEMENT,
g.str_LIBELLE AS str_LIBELLE_GROSSISTE
FROM t_inventaire_famille t, t_famille f, t_famillearticle fa, t_zone_geographique z, t_grossiste g
WHERE t.bool_INVENTAIRE = true AND fa.lg_FAMILLEARTICLE_ID = f.lg_FAMILLEARTICLE_ID AND f.lg_FAMILLE_ID = t.lg_FAMILLE_ID
AND g.lg_GROSSISTE_ID = f.lg_GROSSISTE_ID
AND z.lg_ZONE_GEO_ID = f.lg_ZONE_GEO_ID AND t.lg_INVENTAIRE_ID LIKE $P{P_REFERENCE}
AND z.`lg_ZONE_GEO_ID` LIKE $P{P_ZONE_ID}  AND fa.`lg_FAMILLEARTICLE_ID` LIKE $P{P_FAMILLEARTICLE_ID} AND g.`lg_GROSSISTE_ID` LIKE $P{P_GROSSISTE_ID} AND t.str_UPDATED_ID LIKE $P{P_USER}
 ORDER BY z.str_CODE ASC, f.str_DESCRIPTION ASC]]>
	</queryString>
