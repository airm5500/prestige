	<field name="str_ETAT" class="java.lang.String"/>
	<variable name="v_total_propose" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{int_QTE_PROPOSEE}]]></variableExpression>
	</variable>
	<variable name="v_total_retenu" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{int_QTE_RETENUE}]]></variableExpression>
	</variable>
