	<queryString>
		<![CDATA[SELECT CAST(f.int_CIP AS CHAR) AS int_CIP, f.str_NAME AS str_NAME,
d.str_FORMULE AS str_FORMULE,
d.int_STOCK_RAYON AS int_STOCK_RAYON, d.int_STOCK_RESERVE AS int_STOCK_RESERVE,
d.int_CIBLE AS int_CIBLE, d.int_DISPONIBLE AS int_DISPONIBLE,
d.int_QTE_PROPOSEE AS int_QTE_PROPOSEE,
COALESCE(d.int_QTE_RETENUE, d.int_QTE_PROPOSEE) AS int_QTE_RETENUE,
d.str_ETAT AS str_ETAT
FROM t_suggestion_reserve_detail d
JOIN t_famille f ON f.lg_FAMILLE_ID = d.lg_FAMILLE_ID
WHERE d.lg_SUGGESTION_RESERVE_ID = $P{P_SUGGESTION_ID}
ORDER BY f.str_NAME ASC]]>
	</queryString>
	<field name="int_CIP" class="java.lang.String"/>
	<field name="str_NAME" class="java.lang.String"/>
	<field name="str_FORMULE" class="java.lang.String"/>
	<field name="int_STOCK_RAYON" class="java.lang.Integer"/>
	<field name="int_STOCK_RESERVE" class="java.lang.Integer"/>
