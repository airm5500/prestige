	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_H_LOGO" class="java.lang.String"/>
	<parameter name="P_H_INSTITUTION" class="java.lang.String"/>
	<parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
	<parameter name="P_PRINTED_BY" class="java.lang.String"/>
	<parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
	<parameter name="P_AUTRE_DESC" class="java.lang.String"/>
	<parameter name="P_SUGGESTION_ID" class="java.lang.String"/>
	<parameter name="P_REF" class="java.lang.String"/>
	<parameter name="P_STATUT" class="java.lang.String"/>
	<parameter name="P_MOTIF" class="java.lang.String"/>
	<parameter name="P_SENS" class="java.lang.String"/>
	<parameter name="P_CREATEUR" class="java.lang.String"/>
	<parameter name="P_CLOTURANT" class="java.lang.String"/>
	<parameter name="P_DATES" class="java.lang.String"/>
	<parameter name="P_CONTROLE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CAST(f.int_CIP AS CHAR) AS int_CIP, f.str_NAME AS str_NAME,
d.int_QTE_PROPOSEE AS int_QTE_PROPOSEE,
COALESCE(d.int_QTE_RETENUE, 0) AS int_QTE_RETENUE,
d.int_QTE_DEPLACEE AS int_QTE_DEPLACEE,
CASE d.str_ETAT
  WHEN 'TRAITEE' THEN 'Traitee' WHEN 'ECHEC' THEN 'Echec'
  WHEN 'SUPPRIMEE' THEN 'Retiree' WHEN 'MODIFIEE' THEN 'Modifiee'
  ELSE 'Non traitee' END AS str_ETAT,
TRIM(CONCAT(COALESCE(d.str_CODE_ECHEC,''), ' ', COALESCE(d.str_MOTIF_LIGNE,''))) AS str_MOTIF
FROM t_suggestion_reserve_detail d
JOIN t_famille f ON f.lg_FAMILLE_ID = d.lg_FAMILLE_ID
WHERE d.lg_SUGGESTION_RESERVE_ID = $P{P_SUGGESTION_ID}
ORDER BY FIELD(d.str_ETAT,'ECHEC','TRAITEE','SUPPRIMEE') , f.str_NAME ASC]]>
	</queryString>
	<field name="int_CIP" class="java.lang.String"/>
	<field name="str_NAME" class="java.lang.String"/>
	<field name="int_QTE_PROPOSEE" class="java.lang.Integer"/>
	<field name="int_QTE_RETENUE" class="java.lang.Integer"/>
	<field name="int_QTE_DEPLACEE" class="java.lang.Integer"/>
	<field name="str_ETAT" class="java.lang.String"/>
	<field name="str_MOTIF" class="java.lang.String"/>
	<variable name="v_total_deplace" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{int_QTE_DEPLACEE}]]></variableExpression>
	</variable>
	<variable name="v_nb_traitees" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Traitee".equals($F{str_ETAT}) ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="v_nb_echecs" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Echec".equals($F{str_ETAT}) ? 1 : 0]]></variableExpression>
	</variable>
