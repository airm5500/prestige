<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rp_reserve_liste_reappro_rayon" language="groovy" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="575" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="cf184572-5904-422d-af69-028a610c46c9">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_H_LOGO" class="java.lang.String"/>
	<parameter name="P_H_INSTITUTION" class="java.lang.String"/>
	<parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
	<parameter name="P_PRINTED_BY" class="java.lang.String"/>
	<parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
	<parameter name="P_AUTRE_DESC" class="java.lang.String"/>
	<parameter name="P_EMPLACEMENT_ID" class="java.lang.String"/>
	<parameter name="P_SEARCH" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT CAST(f.int_CIP AS CHAR) AS int_CIP, f.str_NAME AS str_NAME,
COALESCE(z.str_LIBELLEE, '') AS zone_libelle,
COALESCE(MAX(fs.int_NUMBER_AVAILABLE), 0) AS stock_rayon,
COALESCE(MAX(tsf.int_NUMBER), 0) AS stock_reserve,
COALESCE(f.int_SEUIL_RESERVE, 0) AS seuil_reserve,
f.int_SEUIL_MINI_RAYON AS seuil_mini,
COALESCE(f.int_PAF, 0) AS paf, COALESCE(f.int_PRICE, 0) AS prix,
LEAST(COALESCE(MAX(tsf.int_NUMBER),0), GREATEST(0, COALESCE(f.int_SEUIL_RESERVE,0) - COALESCE(MAX(fs.int_NUMBER_AVAILABLE),0))) AS suggere
FROM t_type_stock_famille tsf
JOIN t_famille f ON f.lg_FAMILLE_ID = tsf.lg_FAMILLE_ID
LEFT JOIN t_zone_geographique z ON z.lg_ZONE_GEO_ID = f.lg_ZONE_GEO_ID
LEFT JOIN t_famille_stock fs ON fs.lg_FAMILLE_ID = tsf.lg_FAMILLE_ID
  AND fs.lg_EMPLACEMENT_ID = tsf.lg_EMPLACEMENT_ID AND fs.str_STATUT = 'enable'
WHERE tsf.lg_TYPE_STOCK_ID = '2' AND tsf.lg_EMPLACEMENT_ID = $P{P_EMPLACEMENT_ID}
AND tsf.str_STATUT = 'enable' AND f.bool_RESERVE = 1
AND (f.str_NAME LIKE $P{P_SEARCH} OR f.str_DESCRIPTION LIKE $P{P_SEARCH} OR CAST(f.int_CIP AS CHAR) LIKE $P{P_SEARCH})
GROUP BY f.lg_FAMILLE_ID, f.int_CIP, f.str_NAME, z.str_LIBELLEE,
f.int_SEUIL_RESERVE, f.int_SEUIL_MINI_RAYON, f.int_PAF, f.int_PRICE
HAVING seuil_mini IS NOT NULL AND stock_rayon <= seuil_mini AND stock_reserve > 0
ORDER BY f.str_DESCRIPTION ASC]]>
	</queryString>
	<field name="int_CIP" class="java.lang.String"/>
	<field name="str_NAME" class="java.lang.String"/>
	<field name="zone_libelle" class="java.lang.String"/>
	<field name="stock_rayon" class="java.lang.Integer"/>
	<field name="stock_reserve" class="java.lang.Integer"/>
	<field name="seuil_reserve" class="java.lang.Integer"/>
	<field name="seuil_mini" class="java.lang.Integer"/>
	<field name="paf" class="java.lang.Integer"/>
	<field name="prix" class="java.lang.Integer"/>
	<field name="suggere" class="java.lang.Long"/>
	<variable name="v_total_sugg" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{suggere}]]></variableExpression>
	</variable>
