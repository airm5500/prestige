    <filter>
        <filter-name>PortPublicAvisFilter</filter-name>
        <filter-class>filter.PortPublicAvisFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>PortPublicAvisFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
