<?xml version="1.0" encoding="UTF-8"?>
<!--
  rp_lots_peremptions.jrxml
  Impression "Voir les lots / peremptions" de la fiche article (gestion du stock).
  Reprend les donnees de l'impression actuelle (date peremption, quantite, n° lot, statut)
  en y ajoutant la date de saisie, l'utilisateur et le stock actuel du produit
  (repete sur chaque ligne meme s'il y a plusieurs lots par produit).
  A deployer dans le repertoire des sources de rapports du serveur (jdom.scr_report_file).
  Parametres : P_CIP (CIP du produit), P_EMPLACEMENT (emplacement de l'utilisateur),
               P_NBRE_MOIS (fenetre de peremption en mois, 24 par defaut comme l'ecran).
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rp_lots_peremptions" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail" uuid="9f1a2b3c-4d5e-6f70-8192-a3b4c5d6e7f8">
    <parameter name="P_H_INSTITUTION" class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_H_PHONE" class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String" isForPrompting="false"/>
    <parameter name="P_CIP" class="java.lang.String"/>
    <parameter name="P_EMPLACEMENT" class="java.lang.String"/>
    <parameter name="P_NBRE_MOIS" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[Integer.valueOf(24)]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT
    f.int_CIP AS cip,
    f.str_NAME AS designation,
    DATE_FORMAT(l.dt_PEREMPTION, '%d/%m/%Y') AS date_peremption,
    l.int_NUMBER AS quantite,
    l.int_NUM_LOT AS num_lot,
    CASE
        WHEN DATEDIFF(DATE(l.dt_PEREMPTION), CURDATE()) < 0
            THEN CONCAT('Périmé il y a ', ABS(DATEDIFF(DATE(l.dt_PEREMPTION), CURDATE())), ' jour(s)')
        WHEN DATEDIFF(DATE(l.dt_PEREMPTION), CURDATE()) = 0
            THEN 'Périme aujourd''hui'
        ELSE CONCAT('Périme dans ', DATEDIFF(DATE(l.dt_PEREMPTION), CURDATE()), ' jour(s)')
    END AS statut,
    DATE_FORMAT(l.dt_CREATED, '%d/%m/%Y %H:%i') AS date_saisie,
    TRIM(CONCAT(IFNULL(u.str_FIRST_NAME, ''), ' ', IFNULL(u.str_LAST_NAME, ''))) AS utilisateur,
    IFNULL((SELECT fs.int_NUMBER_AVAILABLE FROM t_famille_stock fs
            WHERE fs.lg_FAMILLE_ID = f.lg_FAMILLE_ID
              AND fs.lg_EMPLACEMENT_ID = $P{P_EMPLACEMENT}
              AND fs.str_STATUT = 'enable' LIMIT 1), 0) AS stock_actuel
FROM t_lot l
    INNER JOIN t_famille f ON f.lg_FAMILLE_ID = l.lg_FAMILLE_ID
    LEFT JOIN t_user u ON u.lg_USER_ID = l.lg_USER_ID
WHERE f.int_CIP = $P{P_CIP}
    AND f.str_STATUT = 'enable'
    AND l.dt_PEREMPTION IS NOT NULL
    AND l.int_NUM_LOT IS NOT NULL
    AND l.current_stock > 0
    AND DATE(l.dt_PEREMPTION) BETWEEN CURDATE() AND DATE_ADD(CURDATE(), INTERVAL $P{P_NBRE_MOIS} MONTH)
ORDER BY l.dt_PEREMPTION ASC]]>
    </queryString>
    <field name="cip" class="java.lang.String"/>
    <field name="designation" class="java.lang.String"/>
    <field name="date_peremption" class="java.lang.String"/>
    <field name="quantite" class="java.lang.Integer"/>
    <field name="num_lot" class="java.lang.String"/>
    <field name="statut" class="java.lang.String"/>
    <field name="date_saisie" class="java.lang.String"/>
    <field name="utilisateur" class="java.lang.String"/>
    <field name="stock_actuel" class="java.lang.Integer"/>
    <variable name="V_TOTAL_QTE" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{quantite}]]></variableExpression>
    </variable>
    <title>
        <band height="70">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="500" height="18" uuid="a1b2c3d4-0001-0000-0000-000000000001"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="18" width="500" height="14" uuid="a1b2c3d4-0001-0000-0000-000000000002"/>
                <textFieldExpression><![CDATA[$P{P_INSTITUTION_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="32" width="500" height="14" uuid="a1b2c3d4-0001-0000-0000-000000000003"/>
                <textFieldExpression><![CDATA[$P{P_H_PHONE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="48" width="802" height="20" uuid="a1b2c3d4-0001-0000-0000-000000000004"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <pageHeader>
        <band height="24">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="600" height="18" uuid="a1b2c3d4-0002-0000-0000-000000000001"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{cip} == null ? $P{P_CIP} : ($F{cip} + " - " + $F{designation} + "  |  Stock actuel : " + ($F{stock_actuel} == null ? "0" : String.valueOf($F{stock_actuel})))]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement mode="Opaque" backcolor="#EEEEEE" x="0" y="0" width="90" height="20" uuid="a1b2c3d4-0003-0000-0000-000000000001"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[ Date péremption]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#EEEEEE" x="90" y="0" width="70" height="20" uuid="a1b2c3d4-0003-0000-0000-000000000002"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Quantité ]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#EEEEEE" x="160" y="0" width="110" height="20" uuid="a1b2c3d4-0003-0000-0000-000000000003"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[ N° Lot]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#EEEEEE" x="270" y="0" width="180" height="20" uuid="a1b2c3d4-0003-0000-0000-000000000004"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[ Statut]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#EEEEEE" x="450" y="0" width="110" height="20" uuid="a1b2c3d4-0003-0000-0000-000000000005"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[ Date de saisie]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#EEEEEE" x="560" y="0" width="160" height="20" uuid="a1b2c3d4-0003-0000-0000-000000000006"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[ Utilisateur]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#EEEEEE" x="720" y="0" width="82" height="20" uuid="a1b2c3d4-0003-0000-0000-000000000007"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Stock actuel ]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="90" height="18" uuid="a1b2c3d4-0004-0000-0000-000000000001"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[" " + $F{date_peremption}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="90" y="0" width="70" height="18" uuid="a1b2c3d4-0004-0000-0000-000000000002"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{quantite}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="0" width="110" height="18" uuid="a1b2c3d4-0004-0000-0000-000000000003"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[" " + $F{num_lot}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="270" y="0" width="180" height="18" uuid="a1b2c3d4-0004-0000-0000-000000000004"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[" " + $F{statut}]]></textFieldExpression>
