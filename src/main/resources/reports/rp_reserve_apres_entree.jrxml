<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plan du 10/11, point 2 : fenetre « Seuil de réserve atteint » (fin d'une entree en stock) imprimee, A4 paysage.
  Memes colonnes et memes couleurs que la fenetre : seuil mini rayon en rouge gras, seuil maxi rayon en bleu gras,
  quantite proposee en vert gras. Lignes : commonTasks.dto.LigneReserveApresEntreeDTO, valeurs deja mises en forme.
  Embarque dans le war : ReportUtil le compile depuis le classpath lorsqu'il n'est pas copie dans le repertoire des
  rapports de l'officine.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rp_reserve_apres_entree" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <style name="cellule" fontSize="9"/>
    <style name="titre" fontSize="8" isBold="true" mode="Opaque" backcolor="#EFEFEF"/>
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <parameter name="P_PERIODE" class="java.lang.String"/>
    <parameter name="P_INDICATEURS" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_FOOTER_RC" class="java.lang.String"/>

    <field name="cip" class="java.lang.String"/>
    <field name="nom" class="java.lang.String"/>
    <field name="sens" class="java.lang.String"/>
    <field name="rayon" class="java.lang.String"/>
    <field name="reserve" class="java.lang.String"/>
    <field name="seuilMini" class="java.lang.String"/>
    <field name="seuilMaxi" class="java.lang.String"/>
    <field name="quantite" class="java.lang.String"/>

    <title>
        <band height="112" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="520" height="16"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="560" height="12"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INSTITUTION_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="602" y="0" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="602" y="14" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="34" width="802" height="18"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="54" width="802" height="14"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_PERIODE}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" mode="Opaque" x="0" y="74" width="802" height="30" backcolor="#EEF8EE"/>
                <box leftPadding="6" rightPadding="6" topPadding="3" bottomPadding="3"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INDICATEURS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement style="titre" x="0" y="0" width="80" height="18"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[CIP]]></text>
            </staticText>
            <staticText>
                <reportElement style="titre" x="80" y="0" width="262" height="18"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Produit]]></text>
            </staticText>
            <staticText>
                <reportElement style="titre" x="342" y="0" width="100" height="18"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Sens]]></text>
            </staticText>
            <staticText>
                <reportElement style="titre" x="442" y="0" width="60" height="18"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Rayon]]></text>
            </staticText>
            <staticText>
                <reportElement style="titre" x="502" y="0" width="60" height="18"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Réserve]]></text>
            </staticText>
            <staticText>
                <reportElement style="titre" x="562" y="0" width="80" height="18" forecolor="#C62828"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Seuil mini rayon]]></text>
            </staticText>
            <staticText>
                <reportElement style="titre" x="642" y="0" width="80" height="18" forecolor="#1A5F9E"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Seuil maxi rayon]]></text>
            </staticText>
            <staticText>
                <reportElement style="titre" x="722" y="0" width="80" height="18" forecolor="#2E7D32"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <text><![CDATA[Quantité proposée]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Prevent">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="cellule" stretchType="RelativeToTallestObject" x="0" y="0" width="80" height="16"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{cip}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="cellule" stretchType="RelativeToTallestObject" x="80" y="0" width="262" height="16"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nom}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="cellule" stretchType="RelativeToTallestObject" x="342" y="0" width="100" height="16"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{sens}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="cellule" stretchType="RelativeToTallestObject" x="442" y="0" width="60" height="16"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{rayon}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="cellule" stretchType="RelativeToTallestObject" x="502" y="0" width="60" height="16"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{reserve}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="cellule" stretchType="RelativeToTallestObject" x="562" y="0" width="80" height="16" forecolor="#C62828"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{seuilMini}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="cellule" stretchType="RelativeToTallestObject" x="642" y="0" width="80" height="16" forecolor="#1A5F9E"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{seuilMaxi}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="cellule" stretchType="RelativeToTallestObject" x="722" y="0" width="80" height="16" forecolor="#2E7D32"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{quantite}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="15" width="802" height="1" forecolor="#D9D9D9"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="700" height="12"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FOOTER_RC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="702" y="2" width="100" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
