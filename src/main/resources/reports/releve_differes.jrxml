<?xml version="1.0" encoding="UTF-8"?>
<!-- Retours du 09/10 (1) : impression de l'onglet « Solde » de la gestion des differes (API v1/reglement/releve/pdf).
     Memes lignes et memes totaux que l'ecran (releve calcule par le serveur, source de donnees en memoire). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="releve_differes" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
    <style name="ligne">
        <conditionalStyle>
            <conditionExpression><![CDATA["MOIS".equals($F{type})]]></conditionExpression>
            <style mode="Opaque" backcolor="#EEF2F7" isBold="true"/>
        </conditionalStyle>
    </style>
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <parameter name="P_CLIENT" class="java.lang.String"/>
    <parameter name="P_TOTAUX" class="java.lang.String"/>
    <field name="date" class="java.lang.String"/>
    <field name="libelle" class="java.lang.String"/>
    <field name="reference" class="java.lang.String"/>
    <field name="client" class="java.lang.String"/>
    <field name="debit" class="java.lang.Long"/>
    <field name="credit" class="java.lang.Long"/>
    <field name="solde" class="java.lang.Long"/>
    <field name="type" class="java.lang.String"/>
    <title>
        <band height="86">
            <textField isBlankWhenNull="true"><reportElement x="0" y="0" width="360" height="16"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression></textField>
            <textField><reportElement x="365" y="0" width="190" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="365" y="13" width="190" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="0" y="30" width="555" height="16"/><textElement textAlignment="Center"><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="0" y="48" width="555" height="13"/><textElement textAlignment="Center"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_CLIENT}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="0" y="64" width="555" height="14"/><textElement textAlignment="Center"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{P_TOTAUX}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="18">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="18" backcolor="#1E3A5F"/>
                <staticText><reportElement x="2" y="0" width="78" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Date et heure]]></text></staticText>
                <staticText><reportElement x="82" y="0" width="96" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Opération]]></text></staticText>
                <staticText><reportElement x="180" y="0" width="70" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Référence]]></text></staticText>
                <staticText><reportElement x="252" y="0" width="120" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Client]]></text></staticText>
                <staticText><reportElement x="374" y="0" width="58" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Débit]]></text></staticText>
                <staticText><reportElement x="434" y="0" width="58" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Crédit]]></text></staticText>
                <staticText><reportElement x="494" y="0" width="58" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><text><![CDATA[Solde]]></text></staticText>
            </frame>
        </band>
    </columnHeader>
    <detail>
        <band height="14">
            <line><reportElement positionType="FixRelativeToBottom" x="0" y="13" width="555" height="1" forecolor="#E0E0E0"/></line>
            <textField isBlankWhenNull="true" isStretchWithOverflow="false"><reportElement style="ligne" stretchType="RelativeToTallestObject" x="2" y="0" width="78" height="12"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{date}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement style="ligne" stretchType="RelativeToTallestObject" x="82" y="0" width="96" height="12"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{libelle}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement style="ligne" stretchType="RelativeToTallestObject" x="180" y="0" width="70" height="12"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true"><reportElement style="ligne" stretchType="RelativeToTallestObject" x="252" y="0" width="120" height="12"/><textElement textAlignment="Left" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{client}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true" isStretchWithOverflow="false"><reportElement style="ligne" stretchType="RelativeToTallestObject" x="374" y="0" width="58" height="12"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{debit}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true" isStretchWithOverflow="false"><reportElement style="ligne" stretchType="RelativeToTallestObject" x="434" y="0" width="58" height="12"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{credit}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true" isStretchWithOverflow="false"><reportElement style="ligne" stretchType="RelativeToTallestObject" x="494" y="0" width="58" height="12"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{solde}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="14"><textField><reportElement x="455" y="2" width="100" height="12"/><textElement textAlignment="Right"><font size="6"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band>
    </pageFooter>
    <noData>
        <band height="30"><staticText><reportElement x="0" y="8" width="555" height="14"/><textElement textAlignment="Center"><font size="9"/></textElement><text><![CDATA[Aucune vente différée ni règlement sur la période.]]></text></staticText></band>
    </noData>
</jasperReport>
