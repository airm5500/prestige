<?xml version="1.0" encoding="UTF-8"?>
<!--
  Facture d'un carnet depot SANS le detail des medicaments : une ligne par vente.

  Retour du 09/09 : « le meme modele que le document avec les details ». Ce modele reprend donc
  l'en-tete, les couleurs, le pied de page et le total de facture_detail_articles.jrxml, et
  remplace le detail des medicaments par une ligne par vente : la reference de la vente (celle qui
  sert de titre de groupe dans l'edition detaillee), le numero de bon quand il a ete saisi, la
  date, le beneficiaire, son matricule et le montant.

  Le numero affiche n'est plus l'identifiant technique de la ligne de facture, mais la reference
  de la vente, lisible par l'organisme.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="facture_carnet_depot_simple" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <parameter name="P_CODE_FACTURE" class="java.lang.String"/>
    <parameter name="P_TIERS_PAYANT_NAME" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_FOOTER_RC" class="java.lang.String"/>

    <field name="strREFVENTE" class="java.lang.String"/>
    <field name="strREFBON" class="java.lang.String"/>
    <field name="dateVente" class="java.lang.String"/>
    <field name="clientFirstName" class="java.lang.String"/>
    <field name="clientLastName" class="java.lang.String"/>
    <field name="clientNumAssurance" class="java.lang.String"/>
    <field name="dblMONTANT" class="java.lang.Integer"/>

    <variable name="V_TOTAL" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{dblMONTANT}]]></variableExpression>
    </variable>
    <variable name="V_LIGNES" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{strREFVENTE}]]></variableExpression>
    </variable>

    <title>
        <band height="86" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="380" height="16"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="380" height="12"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INSTITUTION_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="385" y="0" width="170" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="385" y="13" width="170" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="34" width="555" height="16"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_CODE_FACTURE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="52" width="555" height="14"/>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TIERS_PAYANT_NAME}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="66" width="555" height="14"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="18" splitType="Stretch">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="555" height="18" backcolor="#2E75B6"/>
                <staticText>
                    <reportElement x="4" y="0" width="56" height="18" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Date]]></text>
                </staticText>
                <staticText>
                    <reportElement x="62" y="0" width="110" height="18" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Vente n°]]></text>
                </staticText>
                <staticText>
                    <reportElement x="174" y="0" width="70" height="18" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[N° bon]]></text>
                </staticText>
                <staticText>
                    <reportElement x="246" y="0" width="160" height="18" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Bénéficiaire]]></text>
                </staticText>
                <staticText>
                    <reportElement x="408" y="0" width="75" height="18" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Matricule]]></text>
                </staticText>
                <staticText>
                    <reportElement x="485" y="0" width="70" height="18" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Montant]]></text>
                </staticText>
            </frame>
        </band>
    </columnHeader>

    <detail>
        <band height="14" splitType="Stretch">
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="13" width="555" height="1" forecolor="#E0E0E0"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="4" y="0" width="56" height="12"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{dateVente}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="62" y="0" width="110" height="12" forecolor="#12564F"/>
                <textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{strREFVENTE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="174" y="0" width="70" height="12"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{strREFBON}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement stretchType="RelativeToTallestObject" x="246" y="0" width="160" height="12"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[(($F{clientFirstName} == null ? "" : $F{clientFirstName}) + " " + ($F{clientLastName} == null ? "" : $F{clientLastName})).trim()]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="408" y="0" width="75" height="12"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{clientNumAssurance}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="485" y="0" width="70" height="12"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{dblMONTANT}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="16">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="420" height="12"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FOOTER_RC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="2" width="100" height="12"/>
                <textElement textAlignment="Right"><font size="6"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="26">
            <frame>
                <reportElement mode="Opaque" x="0" y="4" width="555" height="20" backcolor="#2E75B6"/>
                <textField isBlankWhenNull="true">
                    <reportElement x="4" y="0" width="400" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["TOTAL GÉNÉRAL (" + $V{V_LIGNES} + " vente(s))"]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0" isBlankWhenNull="true">
                    <reportElement x="485" y="0" width="70" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{V_TOTAL}]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </summary>

</jasperReport>
