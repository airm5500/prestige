<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mouchard des ventes modifiées (menu Gestion des fichiers > Ventes modifiées), A4 paysage.
  Une bande par modification (action, référence, date, heure, opérateur, montants avant / après,
  résumé), puis une ligne par produit modifié (changement, CIP, produit, quantités, prix unitaires et
  montants avant / après). Les lignes sont regroupées sur l'identifiant de la modification.

  Le modèle est embarqué dans le war (src/main/resources/reports) : ReportUtil le compile depuis le
  classpath lorsqu'il n'est pas déployé dans le répertoire des rapports de l'officine.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ventes_modifiees" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail" isFloatColumnFooter="true">
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <parameter name="P_PERIODE" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_FOOTER_RC" class="java.lang.String"/>

    <field name="id" class="java.lang.String"/>
    <field name="action" class="java.lang.String"/>
    <field name="venteRef" class="java.lang.String"/>
    <field name="venteDate" class="java.lang.String"/>
    <field name="date" class="java.lang.String"/>
    <field name="heure" class="java.lang.String"/>
    <field name="operateur" class="java.lang.String"/>
    <field name="montantAvant" class="java.lang.Long"/>
    <field name="montantApres" class="java.lang.Long"/>
    <field name="description" class="java.lang.String"/>
    <field name="changement" class="java.lang.String"/>
    <field name="cip" class="java.lang.String"/>
    <field name="produit" class="java.lang.String"/>
    <field name="qteAvant" class="java.lang.Long"/>
    <field name="qteApres" class="java.lang.Long"/>
    <field name="puAvant" class="java.lang.Long"/>
    <field name="puApres" class="java.lang.Long"/>
    <field name="ligneAvant" class="java.lang.Long"/>
    <field name="ligneApres" class="java.lang.Long"/>
    <field name="typeLigne" class="java.lang.String"/>
    <field name="valeurAvant" class="java.lang.String"/>
    <field name="valeurApres" class="java.lang.String"/>

    <variable name="NB_MODIFS" class="java.lang.Integer" incrementType="Group" incrementGroup="modification" calculation="Count">
        <variableExpression><![CDATA[$F{id}]]></variableExpression>
    </variable>

    <group name="modification" isStartNewPage="false" keepTogether="true">
        <groupExpression><![CDATA[$F{id}]]></groupExpression>
        <groupHeader>
            <band height="32" splitType="Prevent">
                <frame>
                    <reportElement mode="Opaque" x="0" y="2" width="802" height="16" backcolor="#EEF2F7"/>
                    <textField isBlankWhenNull="true">
                        <reportElement x="2" y="0" width="150" height="16"/>
                        <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                        <textFieldExpression><![CDATA[$F{action}]]></textFieldExpression>
                    </textField>
                    <textField isBlankWhenNull="true">
                        <reportElement x="154" y="0" width="200" height="16"/>
                        <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                        <textFieldExpression><![CDATA["Vente " + $F{venteRef} + " du " + $F{venteDate}]]></textFieldExpression>
                    </textField>
                    <textField isBlankWhenNull="true">
                        <reportElement x="356" y="0" width="130" height="16"/>
                        <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                        <textFieldExpression><![CDATA["Modifiée le " + $F{date} + " " + $F{heure}]]></textFieldExpression>
                    </textField>
                    <textField isBlankWhenNull="true">
                        <reportElement x="488" y="0" width="140" height="16"/>
                        <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                        <textFieldExpression><![CDATA["Opérateur : " + $F{operateur}]]></textFieldExpression>
                    </textField>
                    <textField pattern="#,##0" isBlankWhenNull="true">
                        <reportElement x="630" y="0" width="170" height="16"/>
                        <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                        <textFieldExpression><![CDATA["Montant : " + new java.text.DecimalFormat("#,##0").format($F{montantAvant}) + "  ->  " + new java.text.DecimalFormat("#,##0").format($F{montantApres})]]></textFieldExpression>
                    </textField>
                </frame>
                <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                    <reportElement positionType="Float" x="2" y="19" width="798" height="12"/>
                    <textElement verticalAlignment="Top"><font size="7" isItalic="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="4"/>
        </groupFooter>
    </group>

    <title>
        <band height="76" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="500" height="16"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="600" height="12"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INSTITUTION_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="602" y="0" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="602" y="14" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="36" width="802" height="18"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="56" width="802" height="14"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_PERIODE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20" splitType="Stretch">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="20" backcolor="#1F4E79"/>
                <staticText>
                    <reportElement x="2" y="0" width="96" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Changement]]></text>
                </staticText>
                <staticText>
                    <reportElement x="100" y="0" width="62" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[CIP]]></text>
                </staticText>
                <staticText>
                    <reportElement x="164" y="0" width="256" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Left" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Produit]]></text>
                </staticText>
                <staticText>
                    <reportElement x="422" y="0" width="52" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Qté avant]]></text>
                </staticText>
                <staticText>
                    <reportElement x="476" y="0" width="52" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Qté après]]></text>
                </staticText>
                <staticText>
                    <reportElement x="530" y="0" width="64" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[PU avant]]></text>
                </staticText>
                <staticText>
                    <reportElement x="596" y="0" width="64" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[PU après]]></text>
                </staticText>
                <staticText>
                    <reportElement x="662" y="0" width="68" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Montant avant]]></text>
                </staticText>
                <staticText>
                    <reportElement x="732" y="0" width="68" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                    <text><![CDATA[Montant après]]></text>
                </staticText>
            </frame>
        </band>
    </columnHeader>

    <detail>
        <band height="15" splitType="Stretch">
            <!-- Une modification sans produit ne produit pas de ligne de détail ; les lignes INFO ont leur bande -->
            <printWhenExpression><![CDATA["PRODUIT".equals($F{typeLigne})]]></printWhenExpression>
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="14" width="802" height="1" forecolor="#D9D9D9"/>
            </line>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="2" y="1" width="96" height="12"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{changement}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="100" y="1" width="62" height="12"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cip}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="164" y="1" width="256" height="12"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{produit}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="422" y="1" width="52" height="12"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{qteAvant}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="476" y="1" width="52" height="12"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{qteApres}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="530" y="1" width="64" height="12"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{puAvant}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="596" y="1" width="64" height="12"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{puApres}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="662" y="1" width="68" height="12"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{ligneAvant}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement x="732" y="1" width="68" height="12"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{ligneApres}]]></textFieldExpression>
            </textField>
        </band>
        <!-- Récapitulatif d'une modification d'informations ou de date : élément, avant, après -->
        <band height="15" splitType="Stretch">
            <printWhenExpression><![CDATA["INFO".equals($F{typeLigne})]]></printWhenExpression>
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="14" width="802" height="1" forecolor="#D9D9D9"/>
            </line>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="2" y="1" width="160" height="12"/>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{changement}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="164" y="1" width="300" height="12"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Avant : " + $F{valeurAvant}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="468" y="1" width="332" height="12"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Après : " + $F{valeurApres}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="700" height="12"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FOOTER_RC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="702" y="2" width="100" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="18">
            <textField>
                <reportElement x="0" y="4" width="802" height="12"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{NB_MODIFS} + " modification(s)"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
