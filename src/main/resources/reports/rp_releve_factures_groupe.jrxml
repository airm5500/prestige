<?xml version="1.0" encoding="UTF-8"?>
<!-- Releve des factures de GROUPE (menu Facture de groupe).
     PAYSAGE : une facture de groupe rassemble une facture par organisme. Le releve descend
     jusqu'a l'organisme pour qu'on sache a QUI appartient chaque facture, ce qui demande une
     colonne large pour les noms de tiers payants. Le format paysage la donne sans avoir a
     reduire les polices au point de rendre le document penible a lire. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rp_releve_factures_groupe" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" isFloatColumnFooter="true" whenNoDataType="AllSectionsNoDetail" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e11">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>

	<!-- ============================ Palette et styles ============================ -->
	<style name="EnteteColonne" mode="Opaque" backcolor="#1E3A5F" forecolor="#FFFFFF" fontName="SansSerif" fontSize="7" isBold="true" vAlign="Middle" hAlign="Center">
		<box topPadding="0" bottomPadding="0" leftPadding="3" rightPadding="3">
			<pen lineWidth="0.0"/>
		</box>
	</style>
	<!-- Entete d'une colonne de MONTANTS : cale a droite, avec la meme marge que les
	     chiffres en dessous, pour que libelle et colonne tombent sur le meme axe. -->
	<style name="EnteteColonneMontant" style="EnteteColonne" hAlign="Right">
		<box topPadding="0" bottomPadding="0" leftPadding="3" rightPadding="4">
			<pen lineWidth="0.0"/>
		</box>
	</style>
	<style name="EnteteColonneGauche" style="EnteteColonne" hAlign="Left">
		<box topPadding="0" bottomPadding="0" leftPadding="6" rightPadding="3">
			<pen lineWidth="0.0"/>
		</box>
	</style>
	<style name="Cellule" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<box topPadding="0" bottomPadding="0" leftPadding="4" rightPadding="4">
			<pen lineWidth="0.0"/>
			<bottomPen lineWidth="0.25" lineColor="#D6DEE8"/>
		</box>
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F2F6FA"/>
		</conditionalStyle>
	</style>
	<!-- Nom de l'organisme : cale a gauche et un peu plus marque que le reste de la ligne,
	     c'est l'information que l'on cherche du regard. -->
	<style name="CelluleOrganisme" style="Cellule" isBold="true" forecolor="#1E3A5F">
		<box topPadding="0" bottomPadding="0" leftPadding="6" rightPadding="4">
			<pen lineWidth="0.0"/>
			<bottomPen lineWidth="0.25" lineColor="#D6DEE8"/>
		</box>
	</style>
	<!-- Styles de CELLULE : aucune marge interieure ici, sinon la largeur utile de la cellule
	     diminue d'autant et les champs qui l'occupent entierement sont refuses a la
	     compilation. Les marges sont posees sur les champs eux-memes. -->
	<style name="SousTotalFacture" mode="Opaque" backcolor="#EDF2F8" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<box>
			<pen lineWidth="0.0"/>
			<topPen lineWidth="0.25" lineColor="#9AA7B4"/>
		</box>
	</style>
	<style name="TotalGroupe" mode="Opaque" backcolor="#DDE6F0" fontName="SansSerif" fontSize="8" isBold="true" vAlign="Middle">
		<box>
			<pen lineWidth="0.0"/>
			<topPen lineWidth="0.5" lineColor="#1E3A5F"/>
		</box>
	</style>
	<!-- Bandeau d'ouverture d'une facture de groupe : vert-bleu, comme le bandeau de type de
	     vente du releve des factures clients, pour ne pas le confondre avec les entetes. -->
	<style name="EnteteFactureGroupe" mode="Opaque" backcolor="#E3F0EF" fontName="SansSerif" fontSize="8" isBold="true" forecolor="#12564F" vAlign="Middle">
		<box>
			<pen lineWidth="0.0"/>
			<topPen lineWidth="0.75" lineColor="#1E7B74"/>
		</box>
	</style>
	<!-- Montants : un zero en vert ou en rouge gras attire l'oeil sur une ligne ou il n'y a
	     justement rien a voir ; il passe en gris discret. -->
	<style name="MontantRegle" style="Cellule" forecolor="#9AA7B4">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{montantRegle} != null && $F{montantRegle}.signum() > 0]]></conditionExpression>
			<style forecolor="#1B6B3A" isBold="true"/>
		</conditionalStyle>
	</style>
	<style name="MontantReste" style="Cellule" forecolor="#9AA7B4">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{montantRestant} != null && $F{montantRestant}.signum() > 0]]></conditionExpression>
			<style forecolor="#A62B1F" isBold="true"/>
		</conditionalStyle>
	</style>
	<!-- Statut : vert quand la facture est soldee, rouge sombre sinon -->
	<style name="Statut" style="Cellule" forecolor="#1B6B3A" isBold="true">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{montantRestant} != null && $F{montantRestant}.signum() > 0]]></conditionExpression>
			<style forecolor="#A62B1F"/>
		</conditionalStyle>
	</style>
	<style name="Groupe" mode="Opaque" backcolor="#FFFFFF" fontName="SansSerif" fontSize="9" isBold="true" forecolor="#1E3A5F" vAlign="Middle">
		<box topPadding="1" bottomPadding="1" leftPadding="6" rightPadding="4">
			<pen lineWidth="0.0"/>
			<leftPen lineWidth="3.0" lineColor="#48A9A6"/>
			<bottomPen lineWidth="0.5" lineColor="#1E3A5F"/>
		</box>
	</style>

	<!-- Les factures d'UN groupe, une par organisme, regroupees par facture de groupe -->
	<subDataset name="facturesGroupe" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e12">
		<parameter name="pGroupeLibelle" class="java.lang.String"/>
		<!-- "facture" (defaut) : un bloc par facture de groupe.
		     "tierspayant"      : un bloc par organisme sur toute la periode. -->
		<parameter name="pRegroupement" class="java.lang.String">
			<defaultValueExpression><![CDATA["facture"]]></defaultValueExpression>
		</parameter>
		<parameter name="pTotalFacture" class="java.math.BigDecimal"/>
		<parameter name="pTotalRegle" class="java.math.BigDecimal"/>
		<parameter name="pTotalRestant" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[]]>
		</queryString>
		<field name="codeFactureGroupe" class="java.lang.String"/>
		<field name="dateEdition" class="java.lang.String"/>
		<field name="codeFacture" class="java.lang.String"/>
		<field name="tiersPayant" class="java.lang.String"/>
		<field name="montantFacture" class="java.math.BigDecimal"/>
		<field name="montantRegle" class="java.math.BigDecimal"/>
		<field name="montantRestant" class="java.math.BigDecimal"/>
		<field name="statut" class="java.lang.String"/>
		<!-- Sous-totaux d'une facture de groupe : ce sont les chiffres que la liste a l'ecran
		     affiche sur une seule ligne ; ils restent visibles, le detail par organisme s'ajoute
		     au-dessus. -->
		<variable name="SOUS_TOTAL_FACTURE" class="java.math.BigDecimal" resetType="Group" resetGroup="factureDeGroupe" calculation="Sum">
			<variableExpression><![CDATA[$F{montantFacture}]]></variableExpression>
		</variable>
		<variable name="SOUS_TOTAL_REGLE" class="java.math.BigDecimal" resetType="Group" resetGroup="factureDeGroupe" calculation="Sum">
			<variableExpression><![CDATA[$F{montantRegle}]]></variableExpression>
		</variable>
		<variable name="SOUS_TOTAL_RESTANT" class="java.math.BigDecimal" resetType="Group" resetGroup="factureDeGroupe" calculation="Sum">
			<variableExpression><![CDATA[$F{montantRestant}]]></variableExpression>
		</variable>
		<variable name="NB_ORGANISMES" class="java.lang.Integer" resetType="Group" resetGroup="factureDeGroupe" calculation="Count">
			<variableExpression><![CDATA[$F{codeFacture}]]></variableExpression>
		</variable>
		<variable name="TOTAL_NB_FACTURES" class="java.lang.Integer" calculation="Count">
			<variableExpression><![CDATA[$F{codeFacture}]]></variableExpression>
		</variable>
		<!-- Un seul regroupement, dont le critere depend du mode demande : le numero de la
		     facture de groupe, ou l'organisme. Les lignes arrivent deja triees dans le bon
		     ordre (cf. ReleveGroupeFactureServiceImpl). -->
		<group name="factureDeGroupe">
			<groupExpression><![CDATA[$P{pRegroupement} != null && $P{pRegroupement}.equals("tierspayant") ? $F{tiersPayant} : $F{codeFactureGroupe}]]></groupExpression>
		</group>
	</subDataset>

	<parameter name="P_H_INSTITUTION" class="java.lang.String"/>
	<parameter name="P_AUTRE_DESC" class="java.lang.String"/>
	<parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
	<parameter name="P_H_LOGO" class="java.lang.String"/>
	<parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
	<parameter name="P_PRINTED_BY" class="java.lang.String"/>
	<parameter name="P_FOOTER_RC" class="java.lang.String"/>
	<parameter name="P_NOTE_MONTANT" class="java.lang.String"/>
	<!-- Mode de regroupement demande a l'ecran : "facture" (par facture de groupe) ou
	     "tierspayant" (par organisme sur la periode). -->
	<parameter name="P_REGROUPEMENT" class="java.lang.String">
		<defaultValueExpression><![CDATA["facture"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_NB_FACTURES" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="P_MONTANT_FACTURE" class="java.math.BigDecimal"/>
	<parameter name="P_MONTANT_REGLE" class="java.math.BigDecimal"/>
	<parameter name="P_MONTANT_RESTANT" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[]]>
	</queryString>
	<field name="groupeId" class="java.lang.Integer"/>
	<field name="groupeLibelle" class="java.lang.String"/>
	<field name="montantFacture" class="java.math.BigDecimal"/>
	<field name="montantRegle" class="java.math.BigDecimal"/>
	<field name="montantRestant" class="java.math.BigDecimal"/>
	<field name="factures" class="java.util.List"/>

	<background>
		<band splitType="Stretch"/>
	</background>

	<!-- ============================ En-tete de page ============================ -->
	<pageHeader>
		<band height="90">
			<image onErrorType="Blank">
				<reportElement x="0" y="0" width="72" height="43" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e13"/>
				<imageExpression><![CDATA[$P{P_H_LOGO}]]></imageExpression>
			</image>
			<!-- nom de l'officine centre sur la PAGE, pas sur le logo -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="802" height="24" isRemoveLineWhenBlank="true" forecolor="#1E3A5F" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e14"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{P_H_INSTITUTION} != null ? $P{P_H_INSTITUTION} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="24" width="802" height="13" isRemoveLineWhenBlank="true" forecolor="#5A6B7D" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e15"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="SansSerif" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{P_AUTRE_DESC} != null ? $P{P_AUTRE_DESC} : "")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement mode="Opaque" x="0" y="45" width="802" height="2" backcolor="#1E3A5F" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e16"/>
				<box><pen lineWidth="0.0"/></box>
				<text><![CDATA[]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="0" y="53" width="802" height="24" backcolor="#EDF2F8" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e17"/>
				<box><pen lineWidth="0.0"/><leftPen lineWidth="3.0" lineColor="#48A9A6"/></box>
				<text><![CDATA[]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="8" y="53" width="600" height="24" forecolor="#1E3A5F" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e18"/>
				<box leftPadding="6"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement x="614" y="53" width="182" height="24" forecolor="#5A6B7D" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e19"/>
				<box rightPadding="6"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Édité le " + new SimpleDateFormat("dd/MM/yyyy à HH:mm").format(new Date())]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>

	<!-- ============================ Un bloc par groupe ============================ -->
	<detail>
		<band height="30" splitType="Prevent">
			<componentElement>
				<reportElement x="0" y="2" width="802" height="26" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e20"/>
				<jr:table xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd">
					<datasetRun subDataset="facturesGroupe" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e21">
						<datasetParameter name="pGroupeLibelle">
							<datasetParameterExpression><![CDATA[$F{groupeLibelle}]]></datasetParameterExpression>
						</datasetParameter>
						<datasetParameter name="pRegroupement">
							<datasetParameterExpression><![CDATA[$P{P_REGROUPEMENT}]]></datasetParameterExpression>
						</datasetParameter>
						<datasetParameter name="pTotalFacture">
							<datasetParameterExpression><![CDATA[$F{montantFacture}]]></datasetParameterExpression>
						</datasetParameter>
						<datasetParameter name="pTotalRegle">
							<datasetParameterExpression><![CDATA[$F{montantRegle}]]></datasetParameterExpression>
						</datasetParameter>
						<datasetParameter name="pTotalRestant">
							<datasetParameterExpression><![CDATA[$F{montantRestant}]]></datasetParameterExpression>
						</datasetParameter>
						<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{factures})]]></dataSourceExpression>
					</datasetRun>
					<jr:columnGroup width="802" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e22">
						<!-- Nom du groupe, en tete de son propre bloc -->
						<jr:tableHeader height="18" rowSpan="1">
							<textField>
								<reportElement style="Groupe" x="0" y="0" width="802" height="18" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e23"/>
								<textFieldExpression><![CDATA[$P{pGroupeLibelle}]]></textFieldExpression>
							</textField>
						</jr:tableHeader>
						<!-- Ouverture d'une facture de groupe : son numero et sa date, sur toute la largeur -->
						<jr:groupHeader groupName="factureDeGroupe">
							<jr:cell style="EnteteFactureGroupe" height="15" rowSpan="1">
								<textField>
									<reportElement x="0" y="0" width="802" height="15" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e70"/>
									<box leftPadding="6"/>
									<textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
									<textFieldExpression><![CDATA[$P{pRegroupement} != null && $P{pRegroupement}.equals("tierspayant")
	? ($F{tiersPayant} == null ? "" : $F{tiersPayant}.toUpperCase())
	: ("FACTURE DE GROUPE N° " + $F{codeFactureGroupe}
		+ ($F{dateEdition} == null || $F{dateEdition}.trim().isEmpty() ? "" : "   —   éditée le " + $F{dateEdition}))]]></textFieldExpression>
								</textField>
							</jr:cell>
						</jr:groupHeader>

						<!-- N° de la facture de l'organisme -->
						<jr:column width="80" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e24">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1">
								<staticText>
									<reportElement x="0" y="0" width="80" height="17" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e25"/>
									<box leftPadding="6"/>
									<textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
									<text><![CDATA[TOTAL]]></text>
								</staticText>
							</jr:tableFooter>
							<jr:groupFooter groupName="factureDeGroupe">
								<jr:cell style="SousTotalFacture" height="15" rowSpan="1">
									<staticText>
										<reportElement x="0" y="0" width="80" height="15" forecolor="#5A6B7D" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e71"/>
										<box leftPadding="6"/>
										<textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7.5" isBold="true"/></textElement>
										<text><![CDATA[Sous-total]]></text>
									</staticText>
								</jr:cell>
							</jr:groupFooter>
							<jr:columnHeader height="16" rowSpan="1">
								<staticText>
									<reportElement style="EnteteColonne" x="0" y="0" width="80" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e26"/>
									<text><![CDATA[N° Facture]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField>
									<reportElement style="Cellule" x="0" y="0" width="80" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e27"/>
									<textElement textAlignment="Center"/>
									<textFieldExpression><![CDATA[$F{codeFacture}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>

						<!-- A QUI est la facture : l'organisme -->
						<jr:column width="332" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e28">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1">
								<!-- Le nom du groupe est rappele sur la ligne de total : sur une edition de
								     plusieurs pages, on ne remonte plus chercher de quel groupe il s'agit.
								     Il prolonge le mot TOTAL de la colonne precedente, meme fond. -->
								<textField isBlankWhenNull="true">
									<reportElement x="0" y="0" width="200" height="17" forecolor="#1E3A5F" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e77"/>
									<textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
									<textFieldExpression><![CDATA[$P{pGroupeLibelle} == null ? "" : $P{pGroupeLibelle}.toUpperCase()]]></textFieldExpression>
								</textField>
								<textField isBlankWhenNull="true">
									<reportElement x="200" y="0" width="132" height="17" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e72"/>
									<box rightPadding="8"/>
									<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7.5"/></textElement>
									<textFieldExpression><![CDATA[$V{TOTAL_NB_FACTURES} + ($V{TOTAL_NB_FACTURES}.intValue() > 1 ? " factures" : " facture")]]></textFieldExpression>
								</textField>
							</jr:tableFooter>
							<jr:groupFooter groupName="factureDeGroupe">
								<jr:cell style="SousTotalFacture" height="15" rowSpan="1">
									<textField isBlankWhenNull="true">
										<reportElement x="0" y="0" width="332" height="15" forecolor="#5A6B7D" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e73"/>
										<box rightPadding="8"/>
										<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7.5" isItalic="true"/></textElement>
										<textFieldExpression><![CDATA[$V{NB_ORGANISMES}
	+ ($P{pRegroupement} != null && $P{pRegroupement}.equals("tierspayant")
		? ($V{NB_ORGANISMES}.intValue() > 1 ? " factures" : " facture")
		: ($V{NB_ORGANISMES}.intValue() > 1 ? " organismes" : " organisme"))]]></textFieldExpression>
									</textField>
								</jr:cell>
							</jr:groupFooter>
							<jr:columnHeader height="16" rowSpan="1">
								<textField>
									<reportElement style="EnteteColonneGauche" x="0" y="0" width="332" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e29"/>
									<textFieldExpression><![CDATA[$P{pRegroupement} != null && $P{pRegroupement}.equals("tierspayant") ? "Facture de groupe" : "Tiers payant"]]></textFieldExpression>
								</textField>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField isBlankWhenNull="true">
									<reportElement style="CelluleOrganisme" x="0" y="0" width="332" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e30"/>
									<textElement textAlignment="Left"/>
									<textFieldExpression><![CDATA[$P{pRegroupement} != null && $P{pRegroupement}.equals("tierspayant")
	? ("N° " + $F{codeFactureGroupe}
		+ ($F{dateEdition} == null || $F{dateEdition}.trim().isEmpty() ? "" : "  du " + $F{dateEdition}))
	: $F{tiersPayant}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>

						<!-- Montant facture -->
						<jr:column width="105" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e35">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1">
