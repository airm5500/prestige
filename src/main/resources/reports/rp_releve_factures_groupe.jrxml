<?xml version="1.0" encoding="UTF-8"?>
<!-- Releve des factures de GROUPE (menu Facture de groupe).
     Meme presentation que le releve des factures clients en compte (rp_releve_factures) :
     un bloc par groupe de tiers payants, une ligne par facture de groupe, un total par
     bloc et un total general. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rp_releve_factures_groupe" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" isFloatColumnFooter="true" whenNoDataType="AllSectionsNoDetail" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e11">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>

	<!-- ============================ Palette et styles ============================ -->
	<style name="EnteteColonne" mode="Opaque" backcolor="#1E3A5F" forecolor="#FFFFFF" fontName="SansSerif" fontSize="7" isBold="true" vAlign="Middle" hAlign="Center">
		<box topPadding="0" bottomPadding="0" leftPadding="3" rightPadding="3">
			<pen lineWidth="0.0"/>
		</box>
	</style>
	<!-- Entete d'une colonne de MONTANTS : cale a droite, avec la meme marge que les
	     chiffres en dessous, pour que libelle et colonne tombent sur le meme axe. -->
	<style name="EnteteColonneMontant" style="EnteteColonne" hAlign="Right">
		<box topPadding="0" bottomPadding="0" leftPadding="3" rightPadding="4">
			<pen lineWidth="0.0"/>
		</box>
	</style>
	<style name="Cellule" mode="Transparent" fontName="SansSerif" fontSize="8" vAlign="Middle">
		<box topPadding="0" bottomPadding="0" leftPadding="4" rightPadding="4">
			<pen lineWidth="0.0"/>
			<bottomPen lineWidth="0.25" lineColor="#D6DEE8"/>
		</box>
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F2F6FA"/>
		</conditionalStyle>
	</style>
	<!-- Style de CELLULE : aucune marge interieure, sinon la largeur utile diminue d'autant
	     et les champs qui occupent toute la cellule sont refuses a la compilation. -->
	<style name="TotalGroupe" mode="Opaque" backcolor="#DDE6F0" fontName="SansSerif" fontSize="8" isBold="true" vAlign="Middle">
		<box>
			<pen lineWidth="0.0"/>
			<topPen lineWidth="0.5" lineColor="#1E3A5F"/>
		</box>
	</style>
	<!-- Montants : un zero en vert ou en rouge gras attire l'oeil sur une ligne ou il n'y a
	     justement rien a voir ; il passe en gris discret. -->
	<style name="MontantRegle" style="Cellule" forecolor="#9AA7B4">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{montantRegle} != null && $F{montantRegle}.signum() > 0]]></conditionExpression>
			<style forecolor="#1B6B3A" isBold="true"/>
		</conditionalStyle>
	</style>
	<style name="MontantReste" style="Cellule" forecolor="#9AA7B4">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{montantRestant} != null && $F{montantRestant}.signum() > 0]]></conditionExpression>
			<style forecolor="#A62B1F" isBold="true"/>
		</conditionalStyle>
	</style>
	<!-- Statut : vert quand la facture de groupe est soldee, rouge sombre sinon -->
	<style name="Statut" style="Cellule" forecolor="#1B6B3A" isBold="true">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{montantRestant} != null && $F{montantRestant}.signum() > 0]]></conditionExpression>
			<style forecolor="#A62B1F"/>
		</conditionalStyle>
	</style>
	<style name="Groupe" mode="Opaque" backcolor="#FFFFFF" fontName="SansSerif" fontSize="9" isBold="true" forecolor="#1E3A5F" vAlign="Middle">
		<box topPadding="1" bottomPadding="1" leftPadding="6" rightPadding="4">
			<pen lineWidth="0.0"/>
			<leftPen lineWidth="3.0" lineColor="#48A9A6"/>
			<bottomPen lineWidth="0.5" lineColor="#1E3A5F"/>
		</box>
	</style>

	<!-- Les factures de groupe d'UN groupe : c'est la liste affichee a l'ecran -->
	<subDataset name="facturesGroupe" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e12">
		<parameter name="pGroupeLibelle" class="java.lang.String"/>
		<parameter name="pTotalFacture" class="java.math.BigDecimal"/>
		<parameter name="pTotalRegle" class="java.math.BigDecimal"/>
		<parameter name="pTotalRestant" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[]]>
		</queryString>
		<field name="codeFacture" class="java.lang.String"/>
		<field name="dateEdition" class="java.lang.String"/>
		<field name="nbFactures" class="java.lang.Integer"/>
		<field name="montantFacture" class="java.math.BigDecimal"/>
		<field name="montantRegle" class="java.math.BigDecimal"/>
		<field name="montantRestant" class="java.math.BigDecimal"/>
		<field name="statut" class="java.lang.String"/>
		<!-- nombre total de factures individuelles contenues dans le bloc du groupe -->
		<variable name="TOTAL_NB_FACTURES" class="java.lang.Integer" calculation="Sum">
			<variableExpression><![CDATA[$F{nbFactures}]]></variableExpression>
		</variable>
	</subDataset>

	<parameter name="P_H_INSTITUTION" class="java.lang.String"/>
	<parameter name="P_AUTRE_DESC" class="java.lang.String"/>
	<parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
	<parameter name="P_H_LOGO" class="java.lang.String"/>
	<parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
	<parameter name="P_PRINTED_BY" class="java.lang.String"/>
	<parameter name="P_FOOTER_RC" class="java.lang.String"/>
	<parameter name="P_NOTE_MONTANT" class="java.lang.String"/>
	<parameter name="P_NB_FACTURES" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="P_MONTANT_FACTURE" class="java.math.BigDecimal"/>
	<parameter name="P_MONTANT_REGLE" class="java.math.BigDecimal"/>
	<parameter name="P_MONTANT_RESTANT" class="java.math.BigDecimal"/>
	<queryString>
		<![CDATA[]]>
	</queryString>
	<field name="groupeId" class="java.lang.Integer"/>
	<field name="groupeLibelle" class="java.lang.String"/>
	<field name="montantFacture" class="java.math.BigDecimal"/>
	<field name="montantRegle" class="java.math.BigDecimal"/>
	<field name="montantRestant" class="java.math.BigDecimal"/>
	<field name="factures" class="java.util.List"/>

	<background>
		<band splitType="Stretch"/>
	</background>

	<!-- ============================ En-tete de page ============================ -->
	<pageHeader>
		<band height="96">
			<image onErrorType="Blank">
				<reportElement x="0" y="0" width="72" height="43" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e13"/>
				<imageExpression><![CDATA[$P{P_H_LOGO}]]></imageExpression>
			</image>
			<!-- nom de l'officine centre sur la PAGE, pas sur le logo -->
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="555" height="24" isRemoveLineWhenBlank="true" forecolor="#1E3A5F" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e14"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="16" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{P_H_INSTITUTION} != null ? $P{P_H_INSTITUTION} : "")]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="24" width="555" height="13" isRemoveLineWhenBlank="true" forecolor="#5A6B7D" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e15"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="SansSerif" size="8"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{P_AUTRE_DESC} != null ? $P{P_AUTRE_DESC} : "")]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement mode="Opaque" x="0" y="47" width="555" height="2" backcolor="#1E3A5F" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e16"/>
				<box><pen lineWidth="0.0"/></box>
				<text><![CDATA[]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="0" y="55" width="555" height="24" backcolor="#EDF2F8" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e17"/>
				<box><pen lineWidth="0.0"/><leftPen lineWidth="3.0" lineColor="#48A9A6"/></box>
				<text><![CDATA[]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="8" y="55" width="412" height="24" forecolor="#1E3A5F" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e18"/>
				<box leftPadding="6"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="SansSerif" size="8.5" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="false">
				<reportElement x="424" y="55" width="125" height="24" forecolor="#5A6B7D" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e19"/>
				<box rightPadding="6"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="7.5"/>
				</textElement>
				<textFieldExpression><![CDATA["Édité le " + new SimpleDateFormat("dd/MM/yyyy à HH:mm").format(new Date())]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>

	<!-- ============================ Un bloc par groupe ============================ -->
	<detail>
		<band height="30" splitType="Stretch">
			<componentElement>
				<reportElement x="0" y="2" width="555" height="26" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e20"/>
				<jr:table xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd">
					<datasetRun subDataset="facturesGroupe" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e21">
						<datasetParameter name="pGroupeLibelle">
							<datasetParameterExpression><![CDATA[$F{groupeLibelle}]]></datasetParameterExpression>
						</datasetParameter>
						<datasetParameter name="pTotalFacture">
							<datasetParameterExpression><![CDATA[$F{montantFacture}]]></datasetParameterExpression>
						</datasetParameter>
						<datasetParameter name="pTotalRegle">
							<datasetParameterExpression><![CDATA[$F{montantRegle}]]></datasetParameterExpression>
						</datasetParameter>
						<datasetParameter name="pTotalRestant">
							<datasetParameterExpression><![CDATA[$F{montantRestant}]]></datasetParameterExpression>
						</datasetParameter>
						<dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($F{factures})]]></dataSourceExpression>
					</datasetRun>
					<jr:columnGroup width="555" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e22">
						<!-- Nom du groupe, en tete de son propre bloc -->
						<jr:tableHeader height="18" rowSpan="1">
							<textField>
								<reportElement style="Groupe" x="0" y="0" width="555" height="18" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e23"/>
								<textFieldExpression><![CDATA[$P{pGroupeLibelle}]]></textFieldExpression>
							</textField>
						</jr:tableHeader>

						<!-- N° de la facture de groupe -->
						<jr:column width="76" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e24">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1">
								<staticText>
									<reportElement x="0" y="0" width="76" height="17" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e25"/>
									<box leftPadding="4"/>
									<textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
									<text><![CDATA[TOTAL]]></text>
								</staticText>
							</jr:tableFooter>
							<jr:columnHeader height="16" rowSpan="1">
								<staticText>
									<reportElement style="EnteteColonne" x="0" y="0" width="76" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e26"/>
									<text><![CDATA[N° Facture]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField>
									<reportElement style="Cellule" x="0" y="0" width="76" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e27"/>
									<textElement textAlignment="Center"/>
									<textFieldExpression><![CDATA[$F{codeFacture}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>

						<!-- Date d'edition de la facture de groupe -->
						<jr:column width="74" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e28">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1"/>
							<jr:columnHeader height="16" rowSpan="1">
								<staticText>
									<reportElement style="EnteteColonne" x="0" y="0" width="74" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e29"/>
									<text><![CDATA[Date d'édition]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField isBlankWhenNull="true">
									<reportElement style="Cellule" x="0" y="0" width="74" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e30"/>
									<textElement textAlignment="Center"/>
									<textFieldExpression><![CDATA[$F{dateEdition}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>

						<!-- Nombre de factures contenues dans la facture de groupe -->
						<jr:column width="62" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e31">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1">
								<textField pattern="#,##0" isBlankWhenNull="true">
									<reportElement x="0" y="0" width="62" height="17" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e32"/>
									<box rightPadding="4"/>
									<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
									<textFieldExpression><![CDATA[$V{TOTAL_NB_FACTURES}]]></textFieldExpression>
								</textField>
							</jr:tableFooter>
							<jr:columnHeader height="16" rowSpan="1">
								<staticText>
									<reportElement style="EnteteColonneMontant" x="0" y="0" width="62" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e33"/>
									<text><![CDATA[Nb factures]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField pattern="#,##0" isBlankWhenNull="true">
									<reportElement style="Cellule" x="0" y="0" width="62" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e34"/>
									<textElement textAlignment="Right"/>
									<textFieldExpression><![CDATA[$F{nbFactures}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>

						<!-- Montant facture -->
						<jr:column width="92" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e35">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1">
								<textField pattern="#,##0" isBlankWhenNull="true">
									<reportElement x="0" y="0" width="92" height="17" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e36"/>
									<box rightPadding="4"/>
									<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
									<textFieldExpression><![CDATA[$P{pTotalFacture}]]></textFieldExpression>
								</textField>
							</jr:tableFooter>
							<jr:columnHeader height="16" rowSpan="1">
								<staticText>
									<reportElement style="EnteteColonneMontant" x="0" y="0" width="92" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e37"/>
									<text><![CDATA[Montant facturé]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField pattern="#,##0" isBlankWhenNull="true">
									<reportElement style="Cellule" x="0" y="0" width="92" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e38"/>
									<textElement textAlignment="Right"/>
									<textFieldExpression><![CDATA[$F{montantFacture}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>

						<!-- Montant regle : en vert, c'est ce qui est encaisse -->
						<jr:column width="92" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e39">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1">
								<textField pattern="#,##0" isBlankWhenNull="true">
									<reportElement x="0" y="0" width="92" height="17" forecolor="#1B6B3A" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e40"/>
									<box rightPadding="4"/>
									<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
									<textFieldExpression><![CDATA[$P{pTotalRegle}]]></textFieldExpression>
								</textField>
							</jr:tableFooter>
							<jr:columnHeader height="16" rowSpan="1">
								<staticText>
									<reportElement style="EnteteColonneMontant" x="0" y="0" width="92" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e41"/>
									<text><![CDATA[Montant réglé]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField pattern="#,##0" isBlankWhenNull="true">
									<reportElement style="MontantRegle" x="0" y="0" width="92" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e42"/>
									<textElement textAlignment="Right"/>
									<textFieldExpression><![CDATA[$F{montantRegle}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>

						<!-- Reste a regler : en rouge des qu'il y a quelque chose a encaisser -->
						<jr:column width="92" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e43">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1">
								<textField pattern="#,##0" isBlankWhenNull="true">
									<reportElement x="0" y="0" width="92" height="17" forecolor="#A62B1F" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e44"/>
									<box rightPadding="4"/>
									<textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="true"/></textElement>
									<textFieldExpression><![CDATA[$P{pTotalRestant}]]></textFieldExpression>
								</textField>
							</jr:tableFooter>
							<jr:columnHeader height="16" rowSpan="1">
								<staticText>
									<reportElement style="EnteteColonneMontant" x="0" y="0" width="92" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e45"/>
									<text><![CDATA[Reste à régler]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField pattern="#,##0" isBlankWhenNull="true">
									<reportElement style="MontantReste" x="0" y="0" width="92" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e46"/>
									<textElement textAlignment="Right"/>
									<textFieldExpression><![CDATA[$F{montantRestant}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>

						<!-- Etat de la facture de groupe : soldee ou en cours -->
						<jr:column width="67" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e47">
							<jr:tableFooter style="TotalGroupe" height="17" rowSpan="1"/>
							<jr:columnHeader height="16" rowSpan="1">
								<staticText>
									<reportElement style="EnteteColonne" x="0" y="0" width="67" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e48"/>
									<text><![CDATA[Statut]]></text>
								</staticText>
							</jr:columnHeader>
							<jr:detailCell height="16">
								<textField isBlankWhenNull="true">
									<reportElement style="Statut" x="0" y="0" width="67" height="16" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e49"/>
									<textElement textAlignment="Center"/>
									<textFieldExpression><![CDATA[$F{statut}]]></textFieldExpression>
								</textField>
							</jr:detailCell>
						</jr:column>
					</jr:columnGroup>
				</jr:table>
			</componentElement>
		</band>
	</detail>

	<!-- ============================ Pieds de page ============================ -->
	<pageFooter>
		<band height="24">
			<staticText>
				<reportElement mode="Opaque" x="0" y="4" width="555" height="1" backcolor="#D6DEE8" uuid="9c1f2f4a-4a51-4a1e-9a34-0a5c1d9b7e50"/>
				<box><pen lineWidth="0.0"/></box>
				<text><![CDATA[]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
