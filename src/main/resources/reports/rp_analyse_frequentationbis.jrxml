<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="rp_analyse_frequentation" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="812" leftMargin="15" rightMargin="15" topMargin="20" bottomMargin="20" isSummaryWithPageHeaderAndFooter="true" uuid="a77abbc7-4160-46aa-88ce-8c54d6506564">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="275"/>
	<property name="ireport.y" value="197"/>
	<subDataset name="ds_evolution" uuid="411657d1-2366-4e7b-b6c3-616ef31dbf64">
		<parameter name="P_DATE_START" class="java.lang.String"/>
		<parameter name="P_DATE_END" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT s.HORAIRE AS HORAIRE, s.TRANCHE_ORDRE AS TRANCHE_ORDRE,
				COALESCE(SUM(o.`int_PRICE`),0) AS MONTANT,
				COUNT(o.`lg_PREENREGISTREMENT_ID`) AS NBRE
			FROM (
				SELECT '00h-06h' AS HORAIRE, 1 AS TRANCHE_ORDRE, 0 AS HMIN, 6 AS HMAX
				UNION ALL SELECT '07h-08h', 2, 7, 8
				UNION ALL SELECT '09h-10h', 3, 9, 10
				UNION ALL SELECT '11h-13h', 4, 11, 13
				UNION ALL SELECT '14h-15h', 5, 14, 15
				UNION ALL SELECT '16h', 6, 16, 16
				UNION ALL SELECT '17h', 7, 17, 17
				UNION ALL SELECT '18h', 8, 18, 18
				UNION ALL SELECT '19h', 9, 19, 19
				UNION ALL SELECT '20h-23h', 10, 20, 23
			) s
			LEFT JOIN t_preenregistrement o
				ON HOUR(o.`dt_CREATED`) BETWEEN s.HMIN AND s.HMAX
				AND o.`dt_CREATED`>=DATE($P{P_DATE_START}) AND o.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
				AND o.`int_PRICE`>0 AND o.`b_IS_CANCEL`=0 AND o.`str_STATUT`='is_Closed'
			GROUP BY s.HORAIRE, s.TRANCHE_ORDRE
			ORDER BY s.TRANCHE_ORDRE]]>
		</queryString>
		<field name="HORAIRE" class="java.lang.String"/>
		<field name="TRANCHE_ORDRE" class="java.lang.Integer"/>
		<field name="MONTANT" class="java.math.BigDecimal"/>
		<field name="NBRE" class="java.lang.Long"/>
	</subDataset>
	<parameter name="P_H_INSTITUTION" class="java.lang.String"/>
	<parameter name="P_AUTRE_DESC" class="java.lang.String"/>
	<parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
	<parameter name="P_H_LOGO" class="java.lang.String"/>
	<parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
	<parameter name="P_PRINTED_BY" class="java.lang.String"/>
	<parameter name="P_H_CC" class="java.lang.String"/>
	<parameter name="P_H_RC" class="java.lang.String"/>
	<parameter name="P_H_CI" class="java.lang.String"/>
	<parameter name="P_H_RI" class="java.lang.String"/>
	<parameter name="P_H_PHONE" class="java.lang.String"/>
	<parameter name="P_DATE_START" class="java.lang.String"/>
	<parameter name="P_DATE_END" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DATE($P{P_DATE_START}) AS DATEOPERATION, 'CUMUL' AS VENDEUR,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 0 AND 6 THEN 1 END) AS `DIX_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 0 AND 6 THEN o.`int_PRICE` ELSE 0 END) AS `DIX_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 7 AND 8 THEN 1 END) AS `UN_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 7 AND 8 THEN o.`int_PRICE` ELSE 0 END) AS `UN_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 9 AND 10 THEN 1 END) AS `DEUX_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 9 AND 10 THEN o.`int_PRICE` ELSE 0 END) AS `DEUX_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 11 AND 13 THEN 1 END) AS `TROIS_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 11 AND 13 THEN o.`int_PRICE` ELSE 0 END) AS `TROIS_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 14 AND 15 THEN 1 END) AS `QUATRE_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 14 AND 15 THEN o.`int_PRICE` ELSE 0 END) AS `QUATRE_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) = 16 THEN 1 END) AS `CINQ_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) = 16 THEN o.`int_PRICE` ELSE 0 END) AS `CINQ_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) = 17 THEN 1 END) AS `SIX_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) = 17 THEN o.`int_PRICE` ELSE 0 END) AS `SIX_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) = 18 THEN 1 END) AS `SEPT_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) = 18 THEN o.`int_PRICE` ELSE 0 END) AS `SEPT_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) = 19 THEN 1 END) AS `HUIT_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) = 19 THEN o.`int_PRICE` ELSE 0 END) AS `HUIT_MONTANT`,
                COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 20 AND 23 THEN 1 END) AS `NEUF_COUNT`,
                SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 20 AND 23 THEN o.`int_PRICE` ELSE 0 END) AS `NEUF_MONTANT`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) BETWEEN 0 AND 6) AS `DIX_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) BETWEEN 7 AND 8) AS `UN_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) BETWEEN 9 AND 10) AS `DEUX_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) BETWEEN 11 AND 13) AS `TROIS_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) BETWEEN 14 AND 15) AS `QUATRE_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) = 16) AS `CINQ_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) = 17) AS `SIX_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) = 18) AS `SEPT_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) = 19) AS `HUIT_REFERNCEVALUE`,
                (SELECT SUM(d.`int_QUANTITY`) FROM t_preenregistrement_detail d,t_preenregistrement p WHERE d.`lg_PREENREGISTREMENT_ID`=p.`lg_PREENREGISTREMENT_ID`
                AND p.`int_PRICE`>0 AND p.`b_IS_CANCEL`=0 AND p.`str_STATUT`='is_Closed'
                AND p.`dt_CREATED`>=DATE($P{P_DATE_START}) AND p.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                AND HOUR(p.`dt_CREATED`) BETWEEN 20 AND 23) AS `NEUF_REFERNCEVALUE`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 0 AND 6 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 0 AND 6 THEN 1 END),0),0) AS `PAN_MOY_DIX`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 7 AND 8 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 7 AND 8 THEN 1 END),0),0) AS `PAN_MOY_UN`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 9 AND 10 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 9 AND 10 THEN 1 END),0),0) AS `PAN_MOY_DEUX`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 11 AND 13 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 11 AND 13 THEN 1 END),0),0) AS `PAN_MOY_TROIS`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 14 AND 15 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 14 AND 15 THEN 1 END),0),0) AS `PAN_MOY_QUATRE`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) = 16 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) = 16 THEN 1 END),0),0) AS `PAN_MOY_CINQ`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) = 17 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) = 17 THEN 1 END),0),0) AS `PAN_MOY_SIX`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) = 18 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) = 18 THEN 1 END),0),0) AS `PAN_MOY_SEPT`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) = 19 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) = 19 THEN 1 END),0),0) AS `PAN_MOY_HUIT`,
                ROUND(SUM(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 20 AND 23 THEN o.`int_PRICE` ELSE 0 END)/NULLIF(COUNT(CASE WHEN HOUR(o.`dt_CREATED`) BETWEEN 20 AND 23 THEN 1 END),0),0) AS `PAN_MOY_NEUF`
                FROM t_preenregistrement o
                WHERE o.`dt_CREATED`>=DATE($P{P_DATE_START}) AND o.`dt_CREATED`<DATE($P{P_DATE_END}) + INTERVAL 1 DAY
                 AND o.`int_PRICE`>0 AND o.`b_IS_CANCEL`=0 AND o.`str_STATUT`='is_Closed']]>
	</queryString>
