			</staticText>
			<textField pattern="#,##0" isBlankWhenNull="true">
				<reportElement x="200" y="8" width="154" height="18" forecolor="#1E3A5F" uuid="90f9751f-19c7-4727-9ea6-e937c3328220"/>
				<box rightPadding="6"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{nbreBon}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement mode="Opaque" x="360" y="8" width="195" height="18" backcolor="#E6F2E9" uuid="a1000001-0000-0000-0000-000000000002"/>
				<box leftPadding="6">
					<pen lineWidth="0.0"/>
				</box>
				<textElement verticalAlignment="Middle">
