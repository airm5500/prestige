					<font fontName="SansSerif" size="9" isBold="true"/>
				</textElement>
				<text><![CDATA[TOTAL GÉNÉRAL]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="200" y="8" width="160" height="18" backcolor="#EDF2F8" uuid="a1000001-0000-0000-0000-000000000001"/>
