	<summary>
		<band height="60">
			<!-- Recapitulatif : une bande unique, lue de gauche a droite, plutot que quatre
			     cases encadrees separement en bas de page. -->
			<staticText>
				<reportElement mode="Opaque" x="0" y="8" width="555" height="18" backcolor="#1E3A5F" uuid="abb2c4ab-e988-4866-91ac-de917cd66f01"/>
				<box>
