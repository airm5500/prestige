		<defaultValueExpression><![CDATA["`t_tiers_payant`.`str_FULLNAME` ASC"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
  `t_tiers_payant`.`str_FULLNAME`,
  `t_facture`.`dbl_MONTANT_CMDE`,
  `t_facture`.`str_CODE_FACTURE`,
  `t_facture`.`int_NB_DOSSIER`,
`t_groupe_factures`.str_CODE_FACTURE as grpcodefact,
`t_facture`.`dt_CREATED`
FROM
  `t_tiers_payant`
  INNER JOIN `t_facture` ON (`t_tiers_payant`.`lg_TIERS_PAYANT_ID` = `t_facture`.`str_CUSTOMER`)
  INNER JOIN `t_groupe_factures` ON (`t_groupe_factures`.`lg_FACTURES_ID` = `t_facture`.`lg_FACTURE_ID`)
  INNER JOIN `t_groupe_tierspayant` ON (`t_groupe_tierspayant`.`lg_GROUPE_ID` = `t_groupe_factures`.`lg_GROUPE_ID`)
WHERE
  `t_groupe_tierspayant`.`lg_GROUPE_ID` = $P{lg_GROUPE} AND
  `t_groupe_factures`.`str_CODE_FACTURE`=$P{P_CODEGRPUPEFACTURE}
ORDER BY $P!{P_ORDER_BY}]]>
	</queryString>
