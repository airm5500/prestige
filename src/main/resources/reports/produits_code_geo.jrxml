<?xml version="1.0" encoding="UTF-8"?>
<!-- Produits par code geo (API v1/produits-code-geo/pdf, plan d'octobre section 6) : codes geo rayon et reserve,
     stocks, colisage, tries par code geo. Alimente par les lignes de l'API. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="produits_code_geo" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
        <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <field name="codeGeo" class="java.lang.String"/>
    <field name="codeGeoReserve" class="java.lang.String"/>
    <field name="emplacement" class="java.lang.String"/>
    <field name="cip" class="java.lang.String"/>
    <field name="libelle" class="java.lang.String"/>
    <field name="stockRayon" class="java.lang.Integer"/>
    <field name="stockReserve" class="java.lang.Integer"/>
    <field name="colisage" class="java.lang.Integer"/>
    <title>
        <band height="56">
            <textField isBlankWhenNull="true"><reportElement x="0" y="0" width="560" height="16"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression></textField>
            <textField><reportElement x="600" y="0" width="202" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="600" y="13" width="202" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="0" y="32" width="802" height="16"/><textElement textAlignment="Center"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="18">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="18" backcolor="#1E3A5F"/>
                <staticText><reportElement x="4" y="0" width="80" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Code géo rayon]]></text></staticText>
                <staticText><reportElement x="86" y="0" width="80" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Code géo réserve]]></text></staticText>
                <staticText><reportElement x="168" y="0" width="100" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Emplacement]]></text></staticText>
                <staticText><reportElement x="270" y="0" width="58" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[CIP]]></text></staticText>
                <staticText><reportElement x="330" y="0" width="270" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Produit]]></text></staticText>
                <staticText><reportElement x="602" y="0" width="60" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Stock rayon]]></text></staticText>
                <staticText><reportElement x="664" y="0" width="64" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Stock réserve]]></text></staticText>
                <staticText><reportElement x="730" y="0" width="68" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Colisage]]></text></staticText>
            </frame>
        </band>
    </columnHeader>
    <detail>
        <band height="15">
            <line><reportElement positionType="FixRelativeToBottom" x="0" y="14" width="802" height="1" forecolor="#E0E0E0"/></line>
            <textField isBlankWhenNull="true"><reportElement x="4" y="0" width="80" height="13"/><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{codeGeo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="86" y="0" width="80" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{codeGeoReserve}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="168" y="0" width="100" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{emplacement}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="270" y="0" width="58" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{cip}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="330" y="0" width="270" height="13"/><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{libelle}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="602" y="0" width="60" height="13"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{stockRayon}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="664" y="0" width="64" height="13"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{stockReserve}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="730" y="0" width="68" height="13"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{colisage}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="14"><textField><reportElement x="702" y="2" width="100" height="12"/><textElement textAlignment="Right"><font size="6"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band>
    </pageFooter>
    <noData>
        <band height="30"><staticText><reportElement x="0" y="8" width="802" height="14"/><textElement textAlignment="Center"><font size="9"/></textElement><text><![CDATA[Aucun produit ne correspond au filtre.]]></text></staticText></band>
    </noData>
</jasperReport>
