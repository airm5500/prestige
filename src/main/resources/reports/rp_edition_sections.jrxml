<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plan du 08/11, points 7 et 8 : edition « par sections », A4 portrait. Les indicateurs en tete, puis chaque section
  de l'ecran (un tableau) en bloc : son titre, la ligne d'en-tete des colonnes (en gras), ses lignes.
  Lignes : commonTasks.dto.LigneEditionSectionDTO, valeurs deja mises en forme comme a l'ecran.
  Disposition A : libelle (225) + six colonnes chiffrees (55). Disposition B : code (62), libelle (175),
  complement (98) + quatre colonnes chiffrees (55).
  Sert a l'analyse des avoirs et au tableau de bord des retours fournisseur (fichiers rp_analyse_avoirs_*.pdf et
  rp_tableau_bord_retours_fournisseur_*.pdf). Embarque dans le war : ReportUtil le compile depuis le classpath
  lorsqu'il n'est pas copie dans le repertoire des rapports de l'officine.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rp_edition_sections" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <style name="ligne" fontSize="8">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{entete}]]></conditionExpression>
            <style mode="Opaque" backcolor="#EFEFEF" isBold="true"/>
        </conditionalStyle>
    </style>
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <parameter name="P_PERIODE" class="java.lang.String"/>
    <parameter name="P_INDICATEURS" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_FOOTER_RC" class="java.lang.String"/>

    <field name="section" class="java.lang.String"/>
    <field name="entete" class="java.lang.Boolean"/>
    <field name="disposition" class="java.lang.String"/>
    <field name="c0" class="java.lang.String"/>
    <field name="c1" class="java.lang.String"/>
    <field name="c2" class="java.lang.String"/>
    <field name="c3" class="java.lang.String"/>
    <field name="c4" class="java.lang.String"/>
    <field name="c5" class="java.lang.String"/>
    <field name="c6" class="java.lang.String"/>

    <group name="GRP_SECTION" minHeightToStartNewPage="60">
        <groupExpression><![CDATA[$F{section}]]></groupExpression>
        <groupHeader>
            <band height="26">
                <textField isBlankWhenNull="true">
                    <reportElement mode="Opaque" x="0" y="6" width="555" height="18" backcolor="#DCE6F1"/>
                    <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA["  " + $F{section}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="112" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="380" height="16"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="420" height="12"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INSTITUTION_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="0" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="355" y="14" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="34" width="555" height="18"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement x="0" y="54" width="555" height="14"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_PERIODE}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement positionType="Float" mode="Opaque" x="0" y="74" width="555" height="30" backcolor="#EEF8EE"/>
                <box leftPadding="6" rightPadding="6" topPadding="3" bottomPadding="3"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INDICATEURS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="14" splitType="Prevent">
            <printWhenExpression><![CDATA["A".equals($F{disposition})]]></printWhenExpression>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="0" y="0" width="225" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c0}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="225" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c1}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="280" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c2}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="335" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c3}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="390" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c4}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="445" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c5}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="500" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c6}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="13" width="555" height="1" forecolor="#D9D9D9"/>
            </line>
        </band>
        <band height="14" splitType="Prevent">
            <printWhenExpression><![CDATA["B".equals($F{disposition})]]></printWhenExpression>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="0" y="0" width="62" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c0}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="62" y="0" width="175" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c1}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="237" y="0" width="98" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c2}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="335" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c3}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="390" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c4}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="445" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c5}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="ligne" stretchType="RelativeToTallestObject" x="500" y="0" width="55" height="14"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{c6}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="13" width="555" height="1" forecolor="#D9D9D9"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="455" height="12"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FOOTER_RC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="2" width="100" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
