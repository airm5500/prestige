<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ordonnancier, A4 paysage : une ligne par produit soumis à ordonnance délivré, avec le client,
  le médecin prescripteur, son numéro d'ordre et le code tableau du produit.

  C'est un registre réglementaire : la ligne est le produit délivré, pas la vente. Une même vente
  y figure donc autant de fois qu'elle contient de produits réglementés.

  Le modèle est embarqué dans le war (src/main/resources/reports) : ReportUtil le compile depuis le
  classpath lorsqu'il n'est pas déployé dans le répertoire des rapports de l'officine.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ordonnancier" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <parameter name="P_PERIODE" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_FOOTER_RC" class="java.lang.String"/>

    <field name="date" class="java.lang.String"/>
    <field name="heure" class="java.lang.String"/>
    <field name="reference" class="java.lang.String"/>
    <field name="client" class="java.lang.String"/>
    <field name="medecin" class="java.lang.String"/>
    <field name="numeroOrdre" class="java.lang.String"/>
    <field name="cip" class="java.lang.String"/>
    <field name="produit" class="java.lang.String"/>
    <field name="codeTableau" class="java.lang.String"/>
    <field name="quantite" class="java.lang.Integer"/>
    <field name="montant" class="java.lang.Integer"/>
    <field name="vendeur" class="java.lang.String"/>

    <variable name="TOTAL_QTE" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{quantite}]]></variableExpression>
    </variable>
    <variable name="TOTAL_MONTANT" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{montant}]]></variableExpression>
    </variable>

    <title>
        <band height="76" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="500" height="16"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="600" height="12"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INSTITUTION_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="602" y="0" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="602" y="14" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="36" width="802" height="18"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="56" width="802" height="14"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_PERIODE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20" splitType="Stretch">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="20" backcolor="#4C9A46"/>
                <staticText>
                    <reportElement x="2" y="0" width="52" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Date]]></text>
                </staticText>
                <staticText>
                    <reportElement x="56" y="0" width="32" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Heure]]></text>
                </staticText>
                <staticText>
                    <reportElement x="90" y="0" width="72" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Référence]]></text>
                </staticText>
                <staticText>
                    <reportElement x="164" y="0" width="112" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Client]]></text>
                </staticText>
                <staticText>
                    <reportElement x="278" y="0" width="112" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Médecin]]></text>
                </staticText>
                <staticText>
                    <reportElement x="392" y="0" width="54" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[N° ordre]]></text>
                </staticText>
                <staticText>
                    <reportElement x="448" y="0" width="48" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[CIP]]></text>
                </staticText>
                <staticText>
                    <reportElement x="498" y="0" width="158" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Produit]]></text>
                </staticText>
                <staticText>
                    <reportElement x="658" y="0" width="34" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Tabl.]]></text>
                </staticText>
                <staticText>
                    <reportElement x="694" y="0" width="24" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Qté]]></text>
                </staticText>
                <staticText>
                    <reportElement x="720" y="0" width="52" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Montant]]></text>
                </staticText>
                <staticText>
                    <reportElement x="774" y="0" width="26" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Vend.]]></text>
                </staticText>
            </frame>
        </band>
    </columnHeader>

    <detail>
        <band height="17" splitType="Stretch">
            <line>
                <reportElement positionType="FixRelativeToBottom" x="0" y="16" width="802" height="1" forecolor="#D9D9D9"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="2" y="1" width="52" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="56" y="1" width="32" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{heure}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="90" y="1" width="72" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="164" y="1" width="112" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{client}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="278" y="1" width="112" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{medecin}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="392" y="1" width="54" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{numeroOrdre}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="448" y="1" width="48" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{cip}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="498" y="1" width="158" height="14"/>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{produit}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="658" y="1" width="34" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{codeTableau}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="694" y="1" width="24" height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{quantite}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="720" y="1" width="52" height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{montant}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="774" y="1" width="26" height="14"/>
                <textElement verticalAlignment="Middle"><font size="6"/></textElement>
                <textFieldExpression><![CDATA[$F{vendeur}]]></textFieldExpression>
            </textField>
        </band>
    </detail>


    <pageFooter>
        <band height="14">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="700" height="12"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FOOTER_RC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="702" y="2" width="100" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="22">
            <line>
                <reportElement x="0" y="0" width="802" height="1"/>
            </line>
            <staticText>
                <reportElement x="498" y="4" width="192" height="14"/>
                <textElement textAlignment="Right"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField pattern="#,##0">
                <reportElement x="694" y="4" width="24" height="14"/>
                <textElement textAlignment="Right"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_QTE}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement x="720" y="4" width="52" height="14"/>
                <textElement textAlignment="Right"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_MONTANT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
