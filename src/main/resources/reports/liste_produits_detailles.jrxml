<?xml version="1.0" encoding="UTF-8"?>
<!--
  Liste des produits détaillés (menu Détails), A4 paysage : un couple produit principal / produit
  détail par ligne, au format de l'aperçu de référence - identifiants, noms, stocks des deux et
  contenance (unités par boîte, portée par le principal).

  Le modèle est embarqué dans le war : ReportUtil le compile depuis le classpath lorsqu'il n'est
  pas déployé dans le répertoire des rapports de l'officine.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="liste_produits_detailles" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <!-- La mention « Détail désactivé » ressort en rouge gras, comme à l'écran -->
    <style name="celluleDetail">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{detailDesactive}]]></conditionExpression>
            <style forecolor="#C0392B" isBold="true"/>
        </conditionalStyle>
    </style>
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <parameter name="P_PERIODE" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_FOOTER_RC" class="java.lang.String"/>

    <field name="cipPP" class="java.lang.String"/>
    <field name="nomPP" class="java.lang.String"/>
    <field name="stockPP" class="java.lang.Long"/>
    <field name="cipPD" class="java.lang.String"/>
    <field name="nomPD" class="java.lang.String"/>
    <field name="contenance" class="java.lang.Long"/>
    <field name="stockPD" class="java.lang.Long"/>
    <field name="detailDesactive" class="java.lang.Boolean"/>

    <title>
        <band height="76" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="500" height="16"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="16" width="600" height="12"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INSTITUTION_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="602" y="0" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="602" y="14" width="200" height="12"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="36" width="802" height="18"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="56" width="802" height="14"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_PERIODE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20" splitType="Stretch">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="20" backcolor="#4C9A46"/>
                <staticText>
                    <reportElement x="2" y="0" width="88" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Code CIP CH]]></text>
                </staticText>
                <staticText>
                    <reportElement x="92" y="0" width="214" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Libellé CH]]></text>
                </staticText>
                <staticText>
                    <reportElement x="308" y="0" width="52" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Stock CH]]></text>
                </staticText>
                <staticText>
                    <reportElement x="364" y="0" width="64" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Contenance]]></text>
                </staticText>
                <staticText>
                    <reportElement x="432" y="0" width="92" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Code CIP Détail]]></text>
                </staticText>
                <staticText>
                    <reportElement x="528" y="0" width="196" height="20" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Libellé Détail]]></text>
                </staticText>
                <staticText>
                    <reportElement x="728" y="0" width="72" height="20" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                    <text><![CDATA[Stock Détail]]></text>
                </staticText>
            </frame>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Stretch">
            <line>
                <reportElement positionType="Float" x="0" y="15" width="802" height="1" forecolor="#D9D9D9"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="2" y="1" width="88" height="14"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cipPP}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="92" y="1" width="214" height="14"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{nomPP}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="308" y="1" width="52" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{stockPP}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="364" y="1" width="64" height="14" forecolor="#1C7C1C"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{contenance}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="432" y="1" width="92" height="14"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cipPD}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement style="celluleDetail" stretchType="RelativeToTallestObject" x="528" y="1" width="196" height="14"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[Boolean.TRUE.equals($F{detailDesactive}) ? "Détail désactivé" : $F{nomPD}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="728" y="1" width="72" height="14"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{stockPD}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="2" width="700" height="12"/>
                <textElement><font size="6"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FOOTER_RC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="702" y="2" width="100" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
