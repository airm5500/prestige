<?xml version="1.0" encoding="UTF-8"?>
<!-- Produits en avoir d'un bon de livraison (API v1/avoirs-bon, demande du 05/10) : produit, client, telephone, vente,
     quantite due et quantite recue dans le bon. Alimente par les lignes de l'API. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="avoirs_bon_livraison" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <field name="cip" class="java.lang.String"/>
    <field name="produit" class="java.lang.String"/>
    <field name="client" class="java.lang.String"/>
    <field name="telephone" class="java.lang.String"/>
    <field name="reference" class="java.lang.String"/>
    <field name="date" class="java.lang.String"/>
    <field name="quantiteDue" class="java.lang.Integer"/>
    <field name="quantiteRecue" class="java.lang.Integer"/>
    <title>
        <band height="60">
            <textField isBlankWhenNull="true"><reportElement x="0" y="0" width="560" height="16"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression></textField>
            <textField><reportElement x="600" y="0" width="202" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="600" y="13" width="202" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="0" y="32" width="802" height="16"/><textElement textAlignment="Center"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="18">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="18" backcolor="#1E3A5F"/>
                <staticText><reportElement x="4" y="0" width="60" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[CIP]]></text></staticText>
                <staticText><reportElement x="66" y="0" width="220" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Produit]]></text></staticText>
                <staticText><reportElement x="288" y="0" width="170" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Client]]></text></staticText>
                <staticText><reportElement x="460" y="0" width="90" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Téléphone]]></text></staticText>
                <staticText><reportElement x="552" y="0" width="90" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Vente]]></text></staticText>
                <staticText><reportElement x="644" y="0" width="70" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Date]]></text></staticText>
                <staticText><reportElement x="716" y="0" width="42" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Due]]></text></staticText>
                <staticText><reportElement x="760" y="0" width="40" height="18" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Reçue]]></text></staticText>
            </frame>
        </band>
    </columnHeader>
    <detail>
        <band height="15">
            <line><reportElement positionType="FixRelativeToBottom" x="0" y="14" width="802" height="1" forecolor="#E0E0E0"/></line>
            <textField isBlankWhenNull="true"><reportElement x="4" y="0" width="60" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{cip}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="66" y="0" width="220" height="13"/><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{produit}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="288" y="0" width="170" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{client}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="460" y="0" width="90" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{telephone}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="552" y="0" width="90" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="644" y="0" width="70" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{date}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="716" y="0" width="42" height="13"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{quantiteDue}]]></textFieldExpression></textField>
            <textField pattern="#,##0" isBlankWhenNull="true"><reportElement x="760" y="0" width="40" height="13"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{quantiteRecue}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="14"><textField><reportElement x="702" y="2" width="100" height="12"/><textElement textAlignment="Right"><font size="6"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band>
    </pageFooter>
    <noData>
        <band height="30"><staticText><reportElement x="0" y="8" width="802" height="14"/><textElement textAlignment="Center"><font size="9"/></textElement><text><![CDATA[Aucun produit de ce bon n'est en avoir.]]></text></staticText></band>
    </noData>
</jasperReport>
