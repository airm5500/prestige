<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chiffre d'affaires d'un depot d'extension (retour du 17/09 : « on doit pouvoir imprimer le chiffre
  d'affaire, prevoir le fichier jrxml »). Modele EMBARQUE : aucun fichier a poser sur les sites.

  Les colonnes sont celles demandees par l'officine, dans son ordre : type de vente, montant TTC, montant
  net, marge, nombre de ventes, montant especes, montant tiers payant. La colonne « reglement » n'est pas
  reprise : le service ne la renseigne jamais pour ces lignes, elle etait systematiquement vide.

  Rappel imprime en pied de document : l'argent de ces ventes est dans la caisse de l'operateur de
  l'officine, pas dans une caisse du depot. Le chiffre appartient au depot, l'encaissement a l'officine.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="depot_chiffre_affaires" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="NoDataSection">
    <style name="ligne" fontSize="8.5">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#F5F8FB"/>
        </conditionalStyle>
    </style>
    <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_INSTITUTION_ADRESSE" class="java.lang.String"/>
    <parameter name="P_AUTRE_DESC" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_FOOTER_RC" class="java.lang.String"/>
    <parameter name="P_TITRE" class="java.lang.String"/>
    <parameter name="P_CRITERES" class="java.lang.String"/>
    <field name="typeVente" class="java.lang.String"/>
    <field name="montantTTC" class="java.lang.Long"/>
    <field name="montantNet" class="java.lang.Long"/>
    <field name="marge" class="java.lang.Long"/>
    <field name="nbreVente" class="java.lang.Long"/>
    <field name="montantEspeces" class="java.lang.Long"/>
    <field name="montantTiersPayant" class="java.lang.Long"/>
    <variable name="totalTTC" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{montantTTC}]]></variableExpression>
    </variable>
    <variable name="totalNet" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{montantNet}]]></variableExpression>
    </variable>
    <variable name="totalMarge" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{marge}]]></variableExpression>
    </variable>
    <variable name="totalVentes" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{nbreVente}]]></variableExpression>
    </variable>
    <variable name="totalEspeces" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{montantEspeces}]]></variableExpression>
    </variable>
    <variable name="totalTiersPayant" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{montantTiersPayant}]]></variableExpression>
    </variable>
    <title>
        <band height="72">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="802" height="14"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="14" width="802" height="11"/>
                <textElement textAlignment="Center"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$P{P_INSTITUTION_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="25" width="802" height="11"/>
                <textElement textAlignment="Center"><font size="7.5"/></textElement>
                <textFieldExpression><![CDATA[$P{P_AUTRE_DESC}]]></textFieldExpression>
            </textField>
            <frame>
                <reportElement mode="Opaque" x="0" y="40" width="802" height="16" backcolor="#2E75B6"/>
                <textField isBlankWhenNull="true">
                    <reportElement x="6" y="0" width="790" height="16" forecolor="#FFFFFF"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9.5" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$P{P_TITRE}]]></textFieldExpression>
                </textField>
            </frame>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="58" width="802" height="12"/>
                <textElement textAlignment="Center"><font size="7.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_CRITERES}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="17">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="16" backcolor="#E4EAF0"/>
                <staticText><reportElement x="4" y="0" width="150" height="16"/>
                    <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[TYPE DE VENTE]]></text></staticText>
                <staticText><reportElement x="154" y="0" width="105" height="16"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MONTANT TTC]]></text></staticText>
                <staticText><reportElement x="259" y="0" width="105" height="16"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MONTANT NET]]></text></staticText>
                <staticText><reportElement x="364" y="0" width="95" height="16"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MARGE]]></text></staticText>
                <staticText><reportElement x="459" y="0" width="75" height="16"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[NBRE VENTES]]></text></staticText>
                <staticText><reportElement x="534" y="0" width="110" height="16"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MONTANT ESPÈCES]]></text></staticText>
                <staticText><reportElement x="644" y="0" width="154" height="16"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MONTANT TIERS PAYANT]]></text></staticText>
            </frame>
        </band>
    </columnHeader>
    <detail>
        <band height="14">
            <textField isBlankWhenNull="true">
                <reportElement style="ligne" x="4" y="0" width="150" height="14"/>
                <textFieldExpression><![CDATA[$F{typeVente}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement style="ligne" x="154" y="0" width="105" height="14"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{montantTTC}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement style="ligne" x="259" y="0" width="105" height="14"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{montantNet}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement style="ligne" x="364" y="0" width="95" height="14"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{marge}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement style="ligne" x="459" y="0" width="75" height="14"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{nbreVente}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement style="ligne" x="534" y="0" width="110" height="14"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{montantEspeces}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement style="ligne" x="644" y="0" width="154" height="14"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{montantTiersPayant}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <pageFooter>
        <band height="14">
            <textField>
                <reportElement x="0" y="2" width="700" height="11"/>
                <textElement><font size="6.5" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Édité le " + new java.text.SimpleDateFormat("dd/MM/yyyy à HH:mm").format(new java.util.Date()) + " par " + ($P{P_PRINTED_BY} == null ? "" : $P{P_PRINTED_BY})]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="700" y="2" width="62" height="11"/>
                <textElement textAlignment="Right"><font size="6.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="762" y="2" width="40" height="11"/>
                <textElement textAlignment="Left"><font size="6.5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.valueOf($V{PAGE_NUMBER})]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    <summary>
        <band height="52">
            <frame>
                <reportElement mode="Opaque" x="0" y="3" width="802" height="17" backcolor="#D6E4F0"/>
                <staticText><reportElement x="4" y="0" width="150" height="17"/>
                    <textElement verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement><text><![CDATA[TOTAL]]></text></staticText>
                <textField pattern="#,##0">
                    <reportElement x="154" y="0" width="105" height="17"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{totalTTC}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0">
                    <reportElement x="259" y="0" width="105" height="17"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{totalNet}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0">
                    <reportElement x="364" y="0" width="95" height="17"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{totalMarge}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0">
                    <reportElement x="459" y="0" width="75" height="17"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{totalVentes}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0">
                    <reportElement x="534" y="0" width="110" height="17"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{totalEspeces}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0">
                    <reportElement x="644" y="0" width="154" height="17"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8.5" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$V{totalTiersPayant}]]></textFieldExpression>
                </textField>
            </frame>
            <staticText>
                <reportElement x="0" y="23" width="802" height="12"/>
                <textElement><font size="7" isItalic="true"/></textElement>
                <text><![CDATA[L'argent de ces ventes est encaissé dans la caisse de l'opérateur de l'officine : le chiffre appartient au dépôt, l'encaissement à l'officine.]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="37" width="802" height="11"/>
                <textElement><font size="6.5"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FOOTER_RC}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    <noData>
        <band height="40">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="802" height="14"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="20" width="802" height="16"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <text><![CDATA[Ce dépôt n'a enregistré aucune vente sur la période demandée.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
