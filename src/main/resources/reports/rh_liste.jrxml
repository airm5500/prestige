                <textField isBlankWhenNull="true"><reportElement x="560" y="0" width="80" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_T7}]]></textFieldExpression></textField>
                <textField isBlankWhenNull="true"><reportElement x="641" y="0" width="80" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_T8}]]></textFieldExpression></textField>
                <textField isBlankWhenNull="true"><reportElement x="722" y="0" width="80" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_T9}]]></textFieldExpression></textField>
            </frame>
        </band>
    </columnHeader>
    <detail>
        <band height="14" splitType="Prevent">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="2" y="1" width="148" height="12"/><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{c1}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="152" y="1" width="80" height="12"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{c2}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="234" y="1" width="80" height="12"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{c3}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="315" y="1" width="80" height="12"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{c4}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="396" y="1" width="80" height="12"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{c5}]]></textFieldExpression></textField>
