            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="560" y="1" width="80" height="12"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{c7}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="641" y="1" width="80" height="12"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{c8}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="722" y="1" width="80" height="12"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{c9}]]></textFieldExpression></textField>
            <line><reportElement positionType="Float" x="0" y="13" width="802" height="1" forecolor="#E0E0E0"/></line>
        </band>
    </detail>
    <pageFooter>
        <band height="14"><textField><reportElement x="702" y="2" width="100" height="12"/><textElement textAlignment="Right"><font size="6"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band>
    </pageFooter>
    <summary>
        <band height="24"><textField><reportElement x="0" y="6" width="802" height="14"><printWhenExpression><![CDATA[$V{REPORT_COUNT} == 0]]></printWhenExpression></reportElement><textElement textAlignment="Center"><font size="9"/></textElement><textFieldExpression><![CDATA["Aucune ligne pour ces critères."]]></textFieldExpression></textField></band>
    </summary>
</jasperReport>
