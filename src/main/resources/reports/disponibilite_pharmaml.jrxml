<?xml version="1.0" encoding="UTF-8"?>
<!-- Disponibilite PharmaML (API v1/disponibilite/pdf, plan d'octobre 1.2) : dernier resultat par produit, non
     disponibles d'abord. Alimente par les lignes de l'API (aucune requete ici). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="disponibilite_pharmaml" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
        <parameter name="P_H_INSTITUTION" class="java.lang.String"/>
    <parameter name="P_PRINTED_BY" class="java.lang.String"/>
    <parameter name="P_H_CLT_INFOS" class="java.lang.String"/>
    <field name="cip" class="java.lang.String"/>
    <field name="produit" class="java.lang.String"/>
    <field name="statut" class="java.lang.String"/>
    <field name="motif" class="java.lang.String"/>
    <field name="dateDispo" class="java.lang.String"/>
    <field name="quantiteDispo" class="java.lang.String"/>
    <field name="remplacant" class="java.lang.String"/>
    <field name="grossiste" class="java.lang.String"/>
    <title>
        <band height="56">
            <textField isBlankWhenNull="true"><reportElement x="0" y="0" width="560" height="16"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_H_INSTITUTION}]]></textFieldExpression></textField>
            <textField><reportElement x="600" y="0" width="202" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="600" y="13" width="202" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Par : " + $P{P_PRINTED_BY}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="0" y="32" width="802" height="16"/><textElement textAlignment="Center"><font size="12" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{P_H_CLT_INFOS}]]></textFieldExpression></textField>
        </band>
    </title>
    <columnHeader>
        <band height="18">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="18" backcolor="#1E3A5F"/>
                <staticText><reportElement x="4" y="0" width="58" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[CIP]]></text></staticText>
                <staticText><reportElement x="64" y="0" width="220" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Produit]]></text></staticText>
                <staticText><reportElement x="286" y="0" width="80" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Disponibilité]]></text></staticText>
                <staticText><reportElement x="368" y="0" width="160" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Motif / commentaire]]></text></staticText>
                <staticText><reportElement x="530" y="0" width="62" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Mise à dispo]]></text></staticText>
                <staticText><reportElement x="594" y="0" width="34" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Qté]]></text></staticText>
                <staticText><reportElement x="630" y="0" width="100" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Remplaçant]]></text></staticText>
                <staticText><reportElement x="732" y="0" width="70" height="18" forecolor="#FFFFFF"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Grossiste]]></text></staticText>
            </frame>
        </band>
    </columnHeader>
    <detail>
        <band height="15">
            <line><reportElement positionType="FixRelativeToBottom" x="0" y="14" width="802" height="1" forecolor="#E0E0E0"/></line>
            <textField isBlankWhenNull="true"><reportElement x="4" y="0" width="58" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{cip}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="64" y="0" width="220" height="13"/><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{produit}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="286" y="0" width="80" height="13"/><textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{statut}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="368" y="0" width="160" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{motif}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="530" y="0" width="62" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{dateDispo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="594" y="0" width="34" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{quantiteDispo}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="630" y="0" width="100" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{remplacant}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="732" y="0" width="70" height="13"/><textElement verticalAlignment="Middle"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{grossiste}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="14"><textField><reportElement x="702" y="2" width="100" height="12"/><textElement textAlignment="Right"><font size="6"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band>
    </pageFooter>
    <noData>
        <band height="30"><staticText><reportElement x="0" y="8" width="802" height="14"/><textElement textAlignment="Center"><font size="9"/></textElement><text><![CDATA[Aucune disponibilité vérifiée pour le moment.]]></text></staticText></band>
    </noData>
</jasperReport>
