<xsd:schema targetNamespace="urn:x-csrp:fr.csrp.protocole:message" xmlns="urn:x-csrp:fr.csrp.protocole:message" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<!--Schema message conforme aux spécifications Pharma-ML v4.8-->
	<!--Déclaration des éléments globaux-->
	<xsd:element name="MESSAGE_OFFICINE">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="ENTETE">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="EMETTEUR" type="ctOfficine"/>
							<xsd:element name="DESTINATAIRE" type="ctRepartiteur"/>
							<xsd:element name="DATE" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Date et heure d'émission du message à la précision seconde</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:dateTime">
										<xsd:pattern value=".+T[^Z+-\.]+"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:any namespace="##other" processContents="strict" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>Pour version différenciée</xsd:documentation>
								</xsd:annotation>
							</xsd:any>
						</xsd:sequence>
						<xsd:anyAttribute namespace="##any" processContents="strict"/>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="CORPS">
					<xsd:complexType>
						<xsd:choice>
							<xsd:element name="COMMANDE">
								<xsd:complexType>
									<xsd:choice>
										<xsd:element name="NORMALE">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="LIGNE_N" maxOccurs="10000">
														<xsd:complexType>
															<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
															<xsd:attributeGroup ref="attgProduit"/>
															<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="required"/>
															<xsd:attribute name="Commentaire_Produit" type="stCommentaireLigneOfficine" use="optional"/>
															<xsd:attributeGroup ref="attgConsignesLivraison"/>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="SPECIALE">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="LIGNE_S" maxOccurs="10000">
														<xsd:complexType>
															<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
															<xsd:attributeGroup ref="attgProduit"/>
															<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="required"/>
															<xsd:attribute name="Commentaire_Produit" type="stCommentaireLigneOfficine" use="optional"/>
															<xsd:attributeGroup ref="attgConsignesLivraison"/>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
												<xsd:attributeGroup ref="attgCodeCommandeSpeciale"/>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="PACKAGE">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="LIGNE_P">
														<xsd:complexType>
															<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
															<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="required">
																<xsd:annotation>
																	<xsd:documentation>Nombre de package commandés</xsd:documentation>
																</xsd:annotation>
															</xsd:attribute>
															<xsd:attribute name="Commentaire_Produit" type="stCommentaireLigneOfficine" use="optional"/>
															<xsd:attributeGroup ref="attgConsignesLivraison"/>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
												<xsd:attributeGroup ref="attgCodeCommandePackage"/>
											</xsd:complexType>
										</xsd:element>
									</xsd:choice>
									<xsd:attribute name="Ref_Cde_Client" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Date_livraison" type="stDateLocale" use="optional">
										<xsd:annotation>
											<xsd:documentation>Date de livraison souhaitée par l'officine</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
									<xsd:attribute name="Commentaire_General" use="optional">
										<xsd:simpleType>
											<xsd:restriction base="xsd:string">
												<xsd:maxLength value="255"/>
												<xsd:minLength value="1"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Commentaire_Livraison" use="optional">
										<xsd:simpleType>
											<xsd:restriction base="xsd:string">
												<xsd:maxLength value="255"/>
												<xsd:minLength value="1"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="REQ_INFO_PRODUIT">
								<xsd:annotation>
									<xsd:documentation>Requête information produit</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="LIGNE" maxOccurs="50">
											<xsd:complexType>
												<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
												<xsd:attributeGroup ref="attgProduit"/>
												<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="required"/>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="Ref_Req_Info_Produit" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:maxLength value="20"/>
												<xsd:minLength value="1"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="REQ_RETOUR">
								<xsd:annotation>
									<xsd:documentation>Demande de retour</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="DOCUMENT" minOccurs="0">
											<xsd:annotation>
												<xsd:documentation>Référence du document objet du retour</xsd:documentation>
											</xsd:annotation>
											<xsd:complexType>
												<xsd:attributeGroup ref="attgDocument"/>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="LIGNE" maxOccurs="50">
											<xsd:complexType>
												<xsd:sequence minOccurs="0">
													<xsd:element name="PRIX">
														<xsd:complexType>
															<xsd:attribute name="Nature" use="required" fixed="PUBTC">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:NMTOKEN">
																		<xsd:minLength value="1"/>
																		<xsd:maxLength value="5"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Valeur" use="required">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:decimal">
																		<xsd:minInclusive value="0"/>
																		<xsd:fractionDigits value="3"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
												<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
												<xsd:attributeGroup ref="attgProduit"/>
												<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="required"/>
												<xsd:attribute name="Motif" type="stCodeReponse" use="required"/>
												<xsd:attribute name="Commentaire_produit" use="optional">
													<xsd:simpleType>
														<xsd:restriction base="xsd:string">
															<xsd:minLength value="1"/>
															<xsd:maxLength value="255"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="Ref_Demande_Retour" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attributeGroup ref="attgDevise"/>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="RECLAMATIONS">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="LIGNE" maxOccurs="50">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="PRODUIT_FACTURE">
														<xsd:complexType>
															<xsd:attributeGroup ref="attgProduit"/>
														</xsd:complexType>
													</xsd:element>
													<xsd:element name="PRODUIT_LIVRE" minOccurs="0">
														<xsd:complexType>
															<xsd:attributeGroup ref="attgProduit"/>
														</xsd:complexType>
													</xsd:element>
													<xsd:element name="PRIX" type="ctPrix" minOccurs="0" maxOccurs="10">
														<xsd:annotation>
															<xsd:documentation>Prix unitaire</xsd:documentation>
														</xsd:annotation>
													</xsd:element>
												</xsd:sequence>
												<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
												<xsd:attribute name="Num_Ligne_Document" type="xsd:positiveInteger" use="optional"/>
												<xsd:attribute name="Motif" type="stCodeReponse" use="required"/>
												<xsd:attribute name="Action" use="required">
													<xsd:annotation>
														<xsd:documentation>Action correctrice souhaitée</xsd:documentation>
													</xsd:annotation>
													<xsd:simpleType>
														<xsd:restriction base="xsd:nonNegativeInteger">
															<xsd:maxInclusive value="9999"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
												<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="required"/>
												<xsd:attribute name="Quantite_prevue" type="xsd:positiveInteger" use="optional"/>
												<xsd:attribute name="Quantite_livree" type="xsd:nonNegativeInteger" use="optional"/>
												<xsd:attribute name="Quantite_facturee" type="xsd:nonNegativeInteger" use="optional"/>
												<xsd:attribute name="Commentaire" use="optional">
													<xsd:simpleType>
														<xsd:restriction base="xsd:string">
															<xsd:minLength value="1"/>
															<xsd:maxLength value="255"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="Ref_Reclamation" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attributeGroup ref="attgDocument"/>
									<xsd:attributeGroup ref="attgDevise"/>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="INVENTAIRE">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="LIGNE" maxOccurs="10000">
											<xsd:complexType>
												<xsd:choice>
													<xsd:element name="PRODUIT_CODIFIE">
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="PRIX_PC" minOccurs="0">
																	<xsd:complexType>
																		<xsd:attribute name="Nature" use="required" fixed="PUBTC">
																			<xsd:simpleType>
																				<xsd:restriction base="xsd:NMTOKEN">
																					<xsd:minLength value="1"/>
																					<xsd:maxLength value="5"/>
																				</xsd:restriction>
																			</xsd:simpleType>
																		</xsd:attribute>
																		<xsd:attribute name="Valeur" use="required">
																			<xsd:simpleType>
																				<xsd:restriction base="xsd:decimal">
																					<xsd:minInclusive value="0"/>
																					<xsd:fractionDigits value="3"/>
																				</xsd:restriction>
																			</xsd:simpleType>
																		</xsd:attribute>
																	</xsd:complexType>
																</xsd:element>
																<xsd:element name="TAXE_PC" type="ctTaxe" minOccurs="0" maxOccurs="9"/>
															</xsd:sequence>
															<xsd:attributeGroup ref="attgProduit"/>
															<xsd:attribute name="Nom_Fabricant" type="stNomFabricant" use="optional"/>
															<xsd:attribute name="Marge" type="stTaux" use="optional"/>
														</xsd:complexType>
													</xsd:element>
													<xsd:element name="PRODUIT_CLAIR">
														<xsd:complexType>
															<xsd:choice minOccurs="0">
																<xsd:element name="INFOS_ACHAT">
																	<xsd:complexType>
																		<xsd:sequence>
																			<xsd:element name="PRIX_IA" minOccurs="0">
																				<xsd:complexType>
																					<xsd:attribute name="Nature" use="required" fixed="PHAHT">
																						<xsd:simpleType>
																							<xsd:restriction base="xsd:NMTOKEN">
																								<xsd:minLength value="1"/>
																								<xsd:maxLength value="5"/>
																							</xsd:restriction>
																						</xsd:simpleType>
																					</xsd:attribute>
																					<xsd:attribute name="Valeur" use="required">
																						<xsd:simpleType>
																							<xsd:restriction base="xsd:decimal">
																								<xsd:minInclusive value="0"/>
																								<xsd:fractionDigits value="3"/>
																							</xsd:restriction>
																						</xsd:simpleType>
																					</xsd:attribute>
																				</xsd:complexType>
																			</xsd:element>
																		</xsd:sequence>
																	</xsd:complexType>
																</xsd:element>
																<xsd:element name="INFOS_VENTE">
																	<xsd:complexType>
																		<xsd:sequence>
																			<xsd:element name="PRIX_IV" minOccurs="0">
																				<xsd:complexType>
																					<xsd:attribute name="Nature" use="required" fixed="PUBTC">
																						<xsd:simpleType>
																							<xsd:restriction base="xsd:NMTOKEN">
																								<xsd:minLength value="1"/>
																								<xsd:maxLength value="5"/>
																							</xsd:restriction>
																						</xsd:simpleType>
																					</xsd:attribute>
																					<xsd:attribute name="Valeur" use="required">
																						<xsd:simpleType>
																							<xsd:restriction base="xsd:decimal">
																								<xsd:minInclusive value="0"/>
																								<xsd:fractionDigits value="3"/>
																							</xsd:restriction>
																						</xsd:simpleType>
																					</xsd:attribute>
																				</xsd:complexType>
																			</xsd:element>
																			<xsd:element name="TAXE_IV" type="ctTaxe" minOccurs="0" maxOccurs="9"/>
																		</xsd:sequence>
																		<xsd:attribute name="Marge" type="stTaux" use="required"/>
																	</xsd:complexType>
																</xsd:element>
															</xsd:choice>
															<xsd:attributeGroup ref="attgProduitClair"/>
															<xsd:attribute name="Nom_Fabricant" type="stNomFabricant" use="optional"/>
														</xsd:complexType>
													</xsd:element>
												</xsd:choice>
												<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
												<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="required"/>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="Ref_Inventaire" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Nature" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:string">
												<xsd:enumeration value="COMPLET"/>
												<xsd:enumeration value="PARTIEL"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Date" type="stDateLocale" use="required">
										<xsd:annotation>
											<xsd:documentation>Date de comptage physique</xsd:documentation>
										</xsd:annotation>
									</xsd:attribute>
									<xsd:attributeGroup ref="attgDevise"/>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="REQ_ETAT_COMMANDE">
								<xsd:annotation>
									<xsd:documentation>Requête état commande</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="LIGNE" maxOccurs="10000">
											<xsd:annotation>
												<xsd:documentation>Ligne unique dans le cas d'une commande package</xsd:documentation>
											</xsd:annotation>
											<xsd:complexType>
												<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
												<xsd:attribute name="Num_Ligne_Commande" type="xsd:positiveInteger" use="optional"/>
												<xsd:attributeGroup ref="attgProduit"/>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="Ref_Cde_Client" use="optional">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Ref_Cde_Repartiteur" use="optional">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="LIBRE">
								<xsd:annotation>
									<xsd:documentation>Information libre</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:attribute name="Ref_Info_Libre" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Commentaire" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:string">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="255"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="ERREUR" type="ctErreur"/>
							<xsd:any namespace="##other" processContents="strict">
								<xsd:annotation>
									<xsd:documentation>Pour version différenciée</xsd:documentation>
								</xsd:annotation>
							</xsd:any>
						</xsd:choice>
						<xsd:anyAttribute namespace="##other" processContents="strict">
							<xsd:annotation>
								<xsd:documentation>Pour version différenciée</xsd:documentation>
							</xsd:annotation>
						</xsd:anyAttribute>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="MESSAGE_REPARTITEUR">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="ENTETE">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="EMETTEUR" type="ctRepartiteur"/>
							<xsd:element name="DESTINATAIRE" type="ctOfficine"/>
							<xsd:element name="DATE" minOccurs="0">
								<xsd:annotation>
									<xsd:documentation>date et heure d'émission du message à la précision seconde</xsd:documentation>
								</xsd:annotation>
								<xsd:simpleType>
									<xsd:restriction base="xsd:dateTime">
										<xsd:pattern value=".+T[^Z+-\.]+"/>
									</xsd:restriction>
								</xsd:simpleType>
							</xsd:element>
							<xsd:any namespace="##other" processContents="strict" minOccurs="0"/>
						</xsd:sequence>
						<xsd:anyAttribute namespace="##any" processContents="strict"/>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="CORPS">
					<xsd:complexType>
						<xsd:choice>
							<xsd:element name="REP_COMMANDE">
								<xsd:annotation>
									<xsd:documentation>Réponse à commande</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="INFOS_LIVRAISON" type="ctInformationsLivraison" minOccurs="0"/>
										<xsd:choice>
											<xsd:element name="NORMALE">
												<xsd:complexType>
													<xsd:sequence>
														<xsd:element name="LIGNE_N" maxOccurs="11000">
															<xsd:annotation>
																<xsd:documentation>Ligne détail : référence le produit commandé</xsd:documentation>
															</xsd:annotation>
															<xsd:complexType>
																<xsd:sequence minOccurs="0">
																	<xsd:element name="PRIX_N" type="ctPrix" minOccurs="0" maxOccurs="10"/>
																	<xsd:element name="INDISPONIBILITE_N" type="ctIndisponibilite" minOccurs="0"/>
																</xsd:sequence>
																<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
																<xsd:attribute name="Num_Ligne_Commande" type="xsd:positiveInteger" use="optional"/>
																<xsd:attributeGroup ref="attgProduit"/>
																<xsd:attribute name="Quantite_livree" type="xsd:nonNegativeInteger" use="required"/>
																<xsd:attribute name="Commentaire" type="stCommentaireLigneRepartiteur" use="optional"/>
															</xsd:complexType>
														</xsd:element>
													</xsd:sequence>
												</xsd:complexType>
											</xsd:element>
											<xsd:element name="SPECIALE">
												<xsd:complexType>
													<xsd:sequence>
														<xsd:element name="LIGNE_S" maxOccurs="11000">
															<xsd:annotation>
																<xsd:documentation>Ligne détail : référence le produit commandé</xsd:documentation>
															</xsd:annotation>
															<xsd:complexType>
																<xsd:sequence minOccurs="0">
																	<xsd:element name="PRIX_S" type="ctPrix" minOccurs="0" maxOccurs="10"/>
																	<xsd:element name="INDISPONIBILITE_S" type="ctIndisponibilite" minOccurs="0"/>
																</xsd:sequence>
																<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
																<xsd:attribute name="Num_Ligne_Commande" type="xsd:positiveInteger" use="optional"/>
																<xsd:attributeGroup ref="attgProduit"/>
																<xsd:attribute name="Quantite_livree" type="xsd:nonNegativeInteger" use="required"/>
