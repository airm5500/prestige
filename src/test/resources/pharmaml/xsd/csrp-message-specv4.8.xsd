																		<xsd:attribute name="Moyen_Paiement" type="xsd:NMTOKEN" use="required"/>
																	</xsd:complexType>
																</xsd:element>
															</xsd:sequence>
															<xsd:attribute name="Montant_HT" use="optional">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:decimal">
																		<xsd:fractionDigits value="3"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Montant_Total_Taxes" use="optional">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:decimal">
																		<xsd:fractionDigits value="3"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Montant_TTC" use="optional">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:decimal">
																		<xsd:fractionDigits value="3"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Reste_A_Payer" use="optional">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:decimal">
																		<xsd:fractionDigits value="3"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Pourcentage_Escompte" use="optional">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:decimal">
																		<xsd:fractionDigits value="2"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Montant_Escompte_TTC" use="optional">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:decimal">
																		<xsd:fractionDigits value="3"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Reste_A_Payer_Escompte" use="optional">
																<xsd:annotation>
																	<xsd:documentation>Montant à payer escompte déduit</xsd:documentation>
																</xsd:annotation>
																<xsd:simpleType>
																	<xsd:restriction base="xsd:decimal">
																		<xsd:fractionDigits value="3"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
												<xsd:attribute name="Ref_Facture" use="required">
													<xsd:annotation>
														<xsd:documentation>Numéro de facture émis par le répartiteur</xsd:documentation>
													</xsd:annotation>
													<xsd:simpleType>
														<xsd:restriction base="xsd:NMTOKEN">
															<xsd:minLength value="1"/>
															<xsd:maxLength value="20"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
												<xsd:attribute name="Date" type="stDateLocale" use="required"/>
												<xsd:attribute name="Heure" type="stHeureLocale" use="optional"/>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="LIVRAISON" minOccurs="0" maxOccurs="unbounded">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="LIGNE" minOccurs="0" maxOccurs="11000">
														<xsd:annotation>
															<xsd:documentation>Ligne produit livré ou ligne produit commandé si quantité livrée est nulle.</xsd:documentation>
														</xsd:annotation>
														<xsd:complexType>
															<xsd:sequence>
																<xsd:element name="PRIX" type="ctPrix" minOccurs="0" maxOccurs="10"/>
																<xsd:element name="TAXE_LV" type="ctTaxe" minOccurs="0" maxOccurs="9"/>
																<xsd:element name="REMISE" minOccurs="0">
																	<xsd:complexType>
																		<xsd:attribute name="Taux" type="stTaux" use="optional"/>
																		<xsd:attribute name="Periode" use="optional" default="IMMEDIATE">
																			<xsd:simpleType>
																				<xsd:restriction base="xsd:NMTOKEN">
																					<xsd:minLength value="1"/>
																					<xsd:maxLength value="30"/>
																				</xsd:restriction>
																			</xsd:simpleType>
																		</xsd:attribute>
																		<xsd:attribute name="Categorie" use="optional">
																			<xsd:simpleType>
																				<xsd:restriction base="xsd:NMTOKEN">
																					<xsd:minLength value="1"/>
																					<xsd:maxLength value="20"/>
																				</xsd:restriction>
																			</xsd:simpleType>
																		</xsd:attribute>
																		<xsd:attribute name="Montant_factureHT" type="xsd:decimal" use="optional">
																			<xsd:annotation>
																				<xsd:documentation>Montant facturé HT remise déduite</xsd:documentation>
																			</xsd:annotation>
																		</xsd:attribute>
																	</xsd:complexType>
																</xsd:element>
																<xsd:choice minOccurs="0">
																	<xsd:element name="NORMALE">
																		<xsd:complexType/>
																	</xsd:element>
																	<xsd:element name="SPECIALE">
																		<xsd:complexType>
																			<xsd:attributeGroup ref="attgCodeCommandeSpeciale"/>
																		</xsd:complexType>
																	</xsd:element>
																	<xsd:element name="DETAIL_PACKAGE">
																		<xsd:annotation>
																			<xsd:documentation>Ligne détail du package</xsd:documentation>
																		</xsd:annotation>
																		<xsd:complexType>
																			<xsd:attributeGroup ref="attgCodeCommandePackage"/>
																		</xsd:complexType>
																	</xsd:element>
																	<xsd:element name="GLOBAL_PACKAGE">
																		<xsd:annotation>
																			<xsd:documentation>Ligne globale package (unique)</xsd:documentation>
																		</xsd:annotation>
																		<xsd:complexType>
																			<xsd:attributeGroup ref="attgCodeCommandePackage"/>
																		</xsd:complexType>
																	</xsd:element>
																</xsd:choice>
																<xsd:element name="INDISPONIBILITE" minOccurs="0">
																	<xsd:annotation>
																		<xsd:documentation>Renseigné si quantité livrée n'est pas la quantité commandée</xsd:documentation>
																	</xsd:annotation>
																	<xsd:complexType>
																		<xsd:sequence>
																			<xsd:element name="PRODUIT_REMPLACANT" minOccurs="0">
																				<xsd:complexType>
																					<xsd:attributeGroup ref="attgProduitRemplacant"/>
																				</xsd:complexType>
																			</xsd:element>
																			<xsd:element name="INFOS_DISPO" type="ctInformationsDisponibilite" minOccurs="0"/>
																		</xsd:sequence>
																		<xsd:attributeGroup ref="attgReponseProduit"/>
																	</xsd:complexType>
																</xsd:element>
															</xsd:sequence>
															<xsd:attribute name="Num_Ligne" type="xsd:positiveInteger" use="required"/>
															<xsd:attribute name="Ref_Cde_Client" use="optional">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:NMTOKEN">
																		<xsd:minLength value="1"/>
																		<xsd:maxLength value="20"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Num_Ligne_Client" type="xsd:positiveInteger" use="optional">
																<xsd:annotation>
																	<xsd:documentation>Obligatoire si commande normale ou spéciale, non significatif si commande packagée</xsd:documentation>
																</xsd:annotation>
															</xsd:attribute>
															<xsd:attribute name="Ref_Cde_Repartiteur" use="optional">
																<xsd:simpleType>
																	<xsd:restriction base="xsd:NMTOKEN">
																		<xsd:minLength value="1"/>
																		<xsd:maxLength value="20"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attribute name="Num_Ligne_Cde_Repartiteur" type="xsd:positiveInteger" use="optional"/>
															<xsd:attribute name="Canal" use="optional">
																<xsd:annotation>
																	<xsd:documentation>Canal de pasation de la commande</xsd:documentation>
																</xsd:annotation>
																<xsd:simpleType>
																	<xsd:restriction base="xsd:positiveInteger">
																		<xsd:maxInclusive value="9999"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
															<xsd:attributeGroup ref="attgProduit"/>
															<xsd:attribute name="Quantite_commandee" type="xsd:positiveInteger" use="optional"/>
															<xsd:attribute name="Quantite_livree" type="xsd:integer" use="required"/>
															<xsd:attribute name="Quantite_facturee" type="xsd:nonNegativeInteger" use="optional"/>
															<xsd:attribute name="Produit_remboursable" type="xsd:boolean" use="optional"/>
															<xsd:attribute name="Prix_public_fixe" type="xsd:boolean" use="optional"/>
															<xsd:attribute name="Commentaire" use="optional">
																<xsd:annotation>
																	<xsd:documentation>Commentaire précisant par exemple désignation, type ou nature de la commande</xsd:documentation>
																	<xsd:documentation/>
																</xsd:annotation>
																<xsd:simpleType>
																	<xsd:restriction base="xsd:string">
																		<xsd:minLength value="1"/>
																		<xsd:maxLength value="255"/>
																	</xsd:restriction>
																</xsd:simpleType>
															</xsd:attribute>
														</xsd:complexType>
													</xsd:element>
												</xsd:sequence>
												<xsd:attribute name="Ref_Livraison" use="required">
													<xsd:annotation>
														<xsd:documentation>Numéro de facture émis par le répartiteur</xsd:documentation>
													</xsd:annotation>
													<xsd:simpleType>
														<xsd:restriction base="xsd:NMTOKEN">
															<xsd:minLength value="1"/>
															<xsd:maxLength value="20"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
												<xsd:attribute name="Date" type="stDateLocale" use="required"/>
												<xsd:attribute name="Heure" type="stHeureLocale" use="optional"/>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="STATISTIQUE" minOccurs="0" maxOccurs="20">
											<xsd:complexType>
												<xsd:attribute name="Categorie" use="required">
													<xsd:simpleType>
														<xsd:restriction base="xsd:NMTOKEN">
															<xsd:minLength value="1"/>
															<xsd:maxLength value="20"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
												<xsd:attribute name="Designation_Categorie" use="optional">
													<xsd:simpleType>
														<xsd:restriction base="xsd:normalizedString">
															<xsd:minLength value="1"/>
															<xsd:maxLength value="50"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
												<xsd:attribute name="Date" type="stDateLocale" use="optional"/>
												<xsd:attribute name="Periode" use="optional">
													<xsd:simpleType>
														<xsd:restriction base="xsd:NMTOKEN">
															<xsd:length value="4"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
												<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="optional"/>
												<xsd:attribute name="Nb_Ligne" type="xsd:positiveInteger" use="optional"/>
												<xsd:attribute name="MontantHT" use="optional">
													<xsd:simpleType>
														<xsd:restriction base="xsd:decimal">
															<xsd:fractionDigits value="3"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
												<xsd:attribute name="MontantTTC" use="optional">
													<xsd:simpleType>
														<xsd:restriction base="xsd:decimal">
															<xsd:fractionDigits value="3"/>
														</xsd:restriction>
													</xsd:simpleType>
												</xsd:attribute>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
									<xsd:attribute name="Nature_Document" type="xsd:positiveInteger" use="required" fixed="0003"/>
									<xsd:attribute name="Ref_Document" use="required">
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Id_Client" use="optional">
										<xsd:annotation>
											<xsd:documentation>Doit être égal à Id_Officine de l'entête</xsd:documentation>
										</xsd:annotation>
										<xsd:simpleType>
											<xsd:restriction base="xsd:NMTOKEN">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="20"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Nom_Client" use="optional">
										<xsd:simpleType>
											<xsd:restriction base="xsd:normalizedString">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="50"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attribute name="Adresse_Livraison" use="optional">
										<xsd:simpleType>
											<xsd:restriction base="xsd:string">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="128"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
									<xsd:attributeGroup ref="attgDevise"/>
									<xsd:attribute name="Commentaire" use="optional">
										<xsd:simpleType>
											<xsd:restriction base="xsd:string">
												<xsd:minLength value="1"/>
												<xsd:maxLength value="255"/>
											</xsd:restriction>
										</xsd:simpleType>
									</xsd:attribute>
								</xsd:complexType>
							</xsd:element>
							<xsd:element name="ERREUR" type="ctErreur"/>
							<xsd:any namespace="##other" processContents="strict">
								<xsd:annotation>
									<xsd:documentation>Pour version différenciée</xsd:documentation>
								</xsd:annotation>
							</xsd:any>
						</xsd:choice>
						<xsd:anyAttribute namespace="##other" processContents="strict"/>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<!--Définition des types complexes-->
	<xsd:complexType name="ctOfficine">
		<xsd:attribute name="Nature_Partenaire" type="stCodePartenaire" use="optional" default="OF"/>
		<xsd:attribute name="Id_Client" use="required">
			<xsd:simpleType>
				<xsd:restriction base="xsd:normalizedString">
					<xsd:maxLength value="20"/>
					<xsd:minLength value="1"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="ctPrix">
		<xsd:attribute name="Nature" use="required">
			<xsd:simpleType>
				<xsd:restriction base="xsd:NMTOKEN">
					<xsd:minLength value="1"/>
					<xsd:maxLength value="5"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
		<xsd:attribute name="Valeur" use="required">
			<xsd:simpleType>
				<xsd:restriction base="xsd:decimal">
					<xsd:fractionDigits value="3"/>
					<xsd:minInclusive value="0"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="ctTaxe">
		<xsd:attribute name="Nature" use="required">
			<xsd:simpleType>
				<xsd:restriction base="xsd:NMTOKEN">
					<xsd:length value="4"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
		<xsd:attribute name="Taux" type="stTaux" use="required"/>
	</xsd:complexType>
	<xsd:complexType name="ctRepartiteur">
		<xsd:attribute name="Nature_Partenaire" type="stCodePartenaire" use="optional" default="RE"/>
		<xsd:attribute name="Code_Societe" use="required">
			<xsd:annotation>
				<xsd:documentation>Code attribué au répartiteur par la CSRP</xsd:documentation>
			</xsd:annotation>
			<xsd:simpleType>
				<xsd:restriction base="xsd:NMTOKEN">
					<xsd:length value="2"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
		<xsd:attribute name="Id_Societe" use="required">
			<xsd:annotation>
				<xsd:documentation>Code propriétaire attribué par le répartiteur à ses établissements. Associé au code Société il permet d'identifier de manière unique un établissement.</xsd:documentation>
			</xsd:annotation>
			<xsd:simpleType>
				<xsd:restriction base="xsd:NMTOKEN">
					<xsd:minLength value="1"/>
					<xsd:maxLength value="20"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
	</xsd:complexType>
	<xsd:complexType name="ctInformationsLivraison">
		<xsd:sequence minOccurs="0">
			<xsd:element name="LIVREUR" minOccurs="0">
				<xsd:complexType>
					<xsd:attribute name="Societe" use="optional">
						<xsd:simpleType>
							<xsd:restriction base="xsd:normalizedString">
								<xsd:minLength value="1"/>
								<xsd:maxLength value="30"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
					<xsd:attribute name="Etablissement" use="optional">
						<xsd:simpleType>
							<xsd:restriction base="xsd:normalizedString">
								<xsd:minLength value="1"/>
								<xsd:maxLength value="30"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="TOURNEE" minOccurs="0">
				<xsd:complexType>
					<xsd:attribute name="Reference" use="required">
						<xsd:simpleType>
							<xsd:restriction base="xsd:normalizedString">
								<xsd:minLength value="1"/>
								<xsd:maxLength value="20"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:attribute>
					<xsd:attribute name="Date" type="stDateLocale" use="optional"/>
					<xsd:attribute name="Heure" type="stHeureLocale" use="optional">
						<xsd:annotation>
							<xsd:documentation>Précision de l'heure de livraison est la minute</xsd:documentation>
						</xsd:annotation>
					</xsd:attribute>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="ctInformationsDisponibilite">
		<xsd:attribute name="Date" type="stDateLocale" use="optional"/>
		<xsd:attribute name="Heure" type="stHeureLocale" use="optional"/>
		<xsd:attribute name="Quantite" type="xsd:positiveInteger" use="optional"/>
	</xsd:complexType>
	<xsd:complexType name="ctIndisponibilite">
		<xsd:sequence>
			<xsd:element name="INFOS_DISPO" type="ctInformationsDisponibilite" minOccurs="0"/>
			<xsd:element name="PRODUIT_REMPLACANT" minOccurs="0">
				<xsd:complexType>
					<xsd:attributeGroup ref="attgProduitRemplacant"/>
				</xsd:complexType>
			</xsd:element>
		</xsd:sequence>
		<xsd:attributeGroup ref="attgReponseProduit"/>
	</xsd:complexType>
	<xsd:complexType name="ctErreur">
		<xsd:attribute name="Statut" use="required">
			<xsd:simpleType>
				<xsd:restriction base="xsd:positiveInteger">
					<xsd:maxInclusive value="9999"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
		<xsd:attribute name="Detail" use="optional">
			<xsd:simpleType>
				<xsd:restriction base="xsd:string">
					<xsd:minLength value="1"/>
					<xsd:maxLength value="128"/>
				</xsd:restriction>
			</xsd:simpleType>
		</xsd:attribute>
	</xsd:complexType>
	<!--Définition des types simples-->
	<xsd:simpleType name="stCodePartenaire">
		<xsd:restriction base="xsd:NMTOKEN">
			<xsd:length value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stDevise">
		<xsd:restriction base="xsd:NMTOKEN">
			<xsd:length value="3"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stCodeReponse">
		<xsd:restriction base="xsd:positiveInteger">
			<xsd:maxInclusive value="9999"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stCodificationProduit">
		<xsd:restriction base="xsd:NMTOKEN">
			<xsd:enumeration value="EAN13"/>
			<xsd:enumeration value="CIP39"/>
			<xsd:enumeration value="SPECIALE"/>
			<xsd:enumeration value="CLAIR"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stNumeroLot">
		<xsd:restriction base="xsd:normalizedString">
			<xsd:maxLength value="255"/>
			<xsd:minLength value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stTaux">
		<xsd:restriction base="xsd:decimal">
			<xsd:fractionDigits value="3"/>
			<xsd:minInclusive value="0"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stHeureLocale">
		<xsd:restriction base="xsd:time">
			<xsd:pattern value="[0-2][0-9]:[0-5][0-9]"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stDateLocale">
		<xsd:restriction base="xsd:date">
			<xsd:pattern value="[0-9][0-9][0-9][0-9]\-[0-9][0-9]\-[0-9][0-9]"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stCodeCommandeSpeciale">
		<xsd:restriction base="xsd:normalizedString">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="15"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stCodeCommandePackage">
		<xsd:restriction base="xsd:normalizedString">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="15"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stDesignationProduit">
		<xsd:restriction base="xsd:normalizedString">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="50"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stCodeProduit">
		<xsd:restriction base="xsd:NMTOKEN">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="20"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stNomFabricant">
		<xsd:restriction base="xsd:normalizedString">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="30"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stCommentaireLigneOfficine">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="255"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="stCommentaireLigneRepartiteur">
		<xsd:restriction base="xsd:string">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="255"/>
		</xsd:restriction>
	</xsd:simpleType>
	<!--Définition des groupes d'attribut-->
	<xsd:attributeGroup name="attgProduit">
		<xsd:attribute name="Type_Codification" type="stCodificationProduit" use="required"/>
		<xsd:attribute name="Code_Produit" type="stCodeProduit" use="required"/>
